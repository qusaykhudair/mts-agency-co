<%- include('../partials/top') %>

<div class="page-head">
  <div><h1><%= isAdmin ? 'لوحة الإدارة' : 'لوحة البائع' %></h1><p>مرحباً <%= user.name.split(' ')[0] %> — <%= fmtDate(new Date()) %></p></div>
  <div class="actions">
    <a class="btn btn-<%= stats.pending ? 'primary' : 'soft' %>" href="/seller/orders?status=under_review"><i class="fa-solid fa-receipt"></i> مراجعة الطلبات<% if (stats.pending) { %> (<%= stats.pending %>)<% } %></a>
    <a class="btn btn-soft" href="/seller/products/new"><i class="fa-solid fa-plus"></i> إضافة منتج</a>
  </div>
</div>

<% if (storageWarning) { %>
<div class="alert alert-danger mb-16">
  <i class="fa-solid fa-triangle-exclamation"></i>
  <div class="grow"><b>البيانات غير محفوظة بشكل دائم</b>لا يوجد قرص دائم (Volume) مرتبط بالخدمة على Railway، لذلك ستُحذف الطلبات والحسابات والإيصالات عند كل إعادة نشر. من صفحة الخدمة في Railway أضف Volume (مثلاً على المسار /data) ثم أعد النشر — سيستخدمه المتجر تلقائياً.</div>
</div>
<% } %>

<div class="stats">
  <div class="stat"><span class="ic"><i class="fa-solid fa-sack-dollar"></i></span><div><small>مبيعات هذا الشهر</small><b><%- moneyBase(stats.month_revenue) %></b></div></div>
  <div class="stat warning"><span class="ic"><i class="fa-solid fa-hourglass-half"></i></span><div><small>بانتظار مراجعة الدفع</small><b><%= stats.pending %></b><a class="stretch" href="/seller/orders?status=under_review" aria-label="الطلبات بانتظار المراجعة"></a></div></div>
  <div class="stat info"><span class="ic"><i class="fa-solid fa-gears"></i></span><div><small>بانتظار التسليم</small><b><%= stats.processing %></b><a class="stretch" href="/seller/orders?status=processing" aria-label="الطلبات قيد التجهيز"></a></div></div>
  <div class="stat success"><span class="ic"><i class="fa-solid fa-circle-check"></i></span><div><small>طلبات مسلّمة</small><b><%= stats.delivered %></b><a class="stretch" href="/seller/orders?status=delivered" aria-label="الطلبات المسلّمة"></a></div></div>
</div>

<div class="dash-grid">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>طلبات تحتاج إجراء</h2><a class="sec-link" href="/seller/orders">كل الطلبات <i class="fa-solid fa-arrow-left"></i></a></div>
      <% if (queue.length) { %>
      <div class="table-wrap">
        <table class="table responsive">
          <thead><tr><th>الطلب</th><th>العميل</th><th>المبلغ</th><th>الحالة</th><th></th></tr></thead>
          <tbody>
            <% queue.forEach((o) => { %>
            <tr>
              <td class="t-first"><div class="t-main"><%- include('../partials/mini-cover', { o }) %><div><b><%= o.product_title %></b><small><span class="code"><%= o.code %></span> · <%= timeAgo(o.created_at) %></small></div></div></td>
              <td data-label="العميل"><%= o.buyer_name %></td>
              <td data-label="المبلغ" class="nowrap"><b><%- orderPay(o) %></b><br><small class="muted"><%= o.payment_method_name %></small></td>
              <td data-label="الحالة"><%- include('../partials/status-badge', { status: o.status }) %></td>
              <td><div class="t-actions"><a class="btn btn-primary btn-sm" href="/seller/orders/<%= o.code %>"><%= o.status === 'under_review' ? 'مراجعة' : 'تسليم' %> <i class="fa-solid fa-arrow-left"></i></a></div></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty" style="padding:30px 10px">
        <span class="ic" style="background:var(--success-bg);color:var(--success)"><i class="fa-solid fa-mug-hot"></i></span>
        <h3>لا توجد طلبات معلّقة</h3>
        <p>كل الطلبات تمت معالجتها. ستصلك إشعارات فور وصول طلب جديد.</p>
      </div>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>المبيعات — آخر 14 يوماً</h2>
        <span class="badge badge-brand"><%- moneyBase(chartTotal) %></span>
      </div>
      <div class="card-body">
        <div class="chart" role="img" aria-label="مخطط المبيعات اليومية">
          <% chart.forEach((c) => { const h = c.amount ? Math.max(4, Math.round((c.amount / chartMax) * 100)) : 2; %>
          <div class="bar">
            <span class="tip"><%= c.label %> · <%- moneyBase(c.amount) %> · <%= c.n %> طلب</span>
            <span class="fill<%= c.amount ? '' : ' zero' %>" style="height:<%= h %>%"></span>
            <small><%= c.label %></small>
          </div>
          <% }) %>
        </div>
      </div>
    </section>
  </div>

  <div class="stack">
    <% if (serviceSummary) { %>
    <section class="card">
      <div class="card-head"><h2>طلبات الخدمات</h2><a class="sec-link" href="/seller/service-requests">فتح <i class="fa-solid fa-arrow-left"></i></a></div>
      <div class="card-body">
        <div class="kv">
          <a class="kv-row" href="/seller/service-requests?status=pending"><span>جديدة بانتظار التعيين</span><span><b><%= serviceSummary.pending %></b></span></a>
          <a class="kv-row" href="/seller/service-requests?status=in_progress"><span>قيد التنفيذ</span><span><b><%= serviceSummary.working %></b></span></a>
          <a class="kv-row" href="/seller/service-requests?status=delivered"><span>بانتظار اعتماد العميل</span><span><b><%= serviceSummary.delivered %></b></span></a>
        </div>
      </div>
    </section>
    <% } %>

    <section class="card">
      <div class="card-head"><h2>الأكثر مبيعاً</h2><a class="sec-link" href="/seller/products">المنتجات <i class="fa-solid fa-arrow-left"></i></a></div>
      <div class="card-body stack-sm">
        <% if (topProducts.length) { %>
          <% topProducts.forEach((p, i) => { %>
          <a class="flex gap-12" href="/seller/products/<%= p.id %>/edit">
            <span class="badge <%= i === 0 ? 'badge-gold' : 'badge-muted' %>" style="min-width:26px;justify-content:center"><%= i + 1 %></span>
            <%- include('../partials/mini-cover', { o: p }) %>
            <span class="grow" style="min-width:0"><b class="ellipsis" style="display:block;font-size:13.5px"><%= p.title %></b><small class="muted"><%= p.sales_count %> عملية بيع</small></span>
          </a>
          <% }) %>
        <% } else { %>
          <p class="muted small">لا توجد منتجات بعد.</p>
        <% } %>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/bottom') %>
