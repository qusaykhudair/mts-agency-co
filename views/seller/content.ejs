<%- include('../partials/top') %>

<div class="page-head flex flex-wrap gap-12 between">
  <div>
    <h1><i class="fa-solid fa-pen-to-square"></i> إدارة نصوص الموقع</h1>
    <p>تحكم بكافة النصوص والعناوين والفقرات والأسئلة الشائعة في كافة الأقسام الرئيسية بسهولة تامة.</p>
  </div>
  <div class="actions flex gap-8">
    <a class="btn btn-ghost" href="/" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> معاينة الرئيسية</a>
    <a class="btn btn-ghost" href="/store" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> معاينة المتجر</a>
  </div>
</div>

<form method="post" action="/seller/content" data-ajax novalidate>
  <div class="stack" style="gap:24px">

    <!-- ========================================================= -->
    <!-- 1. الصفحة الرئيسية (MTS Agency)                          -->
    <!-- ========================================================= -->
    <section class="card">
      <div class="card-head flex flex-wrap gap-12 between">
        <h2><i class="fa-solid fa-house"></i> نصوص الصفحة الرئيسية (وكالة MTS)</h2>
        <span class="badge badge-brand">الصفحة الأولى</span>
      </div>
      <div class="card-body stack" style="gap:20px">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">البانر الترحيبي والبحث</h3>
        <div class="form-grid cols-2">
          <div class="field">
            <label class="label" for="home_hero_badge">شارة أعلى العنوان (Badge)</label>
            <input class="input" id="home_hero_badge" name="home_hero_badge" value="<%= s.home_hero_badge %>" maxlength="100">
            <span class="help">النص المميز الصغير مثل: بدون بطاقة دولية</span>
          </div>
          <div class="field">
            <label class="label" for="home_search_placeholder">نص حقل البحث</label>
            <input class="input" id="home_search_placeholder" name="home_search_placeholder" value="<%= s.home_search_placeholder %>" maxlength="120">
          </div>
          <div class="field span-2">
            <label class="label" for="home_hero_title">العنوان الرئيسي للبانر</label>
            <input class="input" id="home_hero_title" name="home_hero_title" value="<%= s.home_hero_title %>" maxlength="200" required>
          </div>
          <div class="field span-2">
            <label class="label" for="home_hero_subtitle">الوصف والفقرة الترحيبية</label>
            <textarea class="textarea" id="home_hero_subtitle" name="home_hero_subtitle" rows="3" maxlength="600"><%= s.home_hero_subtitle %></textarea>
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:8px 0">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">المميزات السريعة أسفل مربع البحث</h3>
        <div class="form-grid cols-3">
          <div class="field">
            <label class="label" for="home_feature_1">الميزة الأولى</label>
            <input class="input" id="home_feature_1" name="home_feature_1" value="<%= s.home_feature_1 %>" maxlength="150">
          </div>
          <div class="field">
            <label class="label" for="home_feature_2">الميزة الثانية</label>
            <input class="input" id="home_feature_2" name="home_feature_2" value="<%= s.home_feature_2 %>" maxlength="150">
          </div>
          <div class="field">
            <label class="label" for="home_feature_3">الميزة الثالثة</label>
            <input class="input" id="home_feature_3" name="home_feature_3" value="<%= s.home_feature_3 %>" maxlength="150">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:8px 0">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">عناوين الأقسام بالرئيسية</h3>
        <div class="form-grid cols-2">
          <div class="field">
            <label class="label" for="home_platforms_title">عنوان شريط المنصات المتوفرة</label>
            <input class="input" id="home_platforms_title" name="home_platforms_title" value="<%= s.home_platforms_title %>" maxlength="150">
          </div>
          <div class="field">
            <label class="label" for="home_popular_title">عنوان قسم المنتجات الأكثر طلباً</label>
            <input class="input" id="home_popular_title" name="home_popular_title" value="<%= s.home_popular_title %>" maxlength="150">
          </div>
          <div class="field">
            <label class="label" for="home_clients_title">عنوان قسم عملاؤنا والشركاء</label>
            <input class="input" id="home_clients_title" name="home_clients_title" value="<%= s.home_clients_title %>" maxlength="150">
          </div>
          <div class="field">
            <label class="label" for="home_reviews_title">عنوان قسم تقييمات العملاء</label>
            <input class="input" id="home_reviews_title" name="home_reviews_title" value="<%= s.home_reviews_title %>" maxlength="150">
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:8px 0">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">قسم خدمات الوكالة (Services)</h3>
        <div class="form-grid cols-2">
          <div class="field">
            <label class="label" for="home_services_label">شارة القسم (Label)</label>
            <input class="input" id="home_services_label" name="home_services_label" value="<%= s.home_services_label %>" maxlength="100">
          </div>
          <div class="field">
            <label class="label" for="home_services_title">عنوان قسم الخدمات</label>
            <input class="input" id="home_services_title" name="home_services_title" value="<%= s.home_services_title %>" maxlength="200">
          </div>
          <div class="field span-2">
            <label class="label" for="home_services_desc">وصف قسم الخدمات</label>
            <textarea class="textarea" id="home_services_desc" name="home_services_desc" rows="2" maxlength="500"><%= s.home_services_desc %></textarea>
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:8px 0">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">قسم خطوات الشراء (01 - 02 - 03)</h3>
        <div class="field">
          <label class="label" for="home_steps_title">عنوان قسم الخطوات الرئيسي</label>
          <input class="input" id="home_steps_title" name="home_steps_title" value="<%= s.home_steps_title %>" maxlength="150">
        </div>
        <div class="form-grid cols-3">
          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الخطوة 01</span>
              <div class="field">
                <label class="label" for="home_step1_title">عنوان الخطوة الأولى</label>
                <input class="input" id="home_step1_title" name="home_step1_title" value="<%= s.home_step1_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="home_step1_desc">شرح الخطوة الأولى</label>
                <textarea class="textarea" id="home_step1_desc" name="home_step1_desc" rows="3" maxlength="300"><%= s.home_step1_desc %></textarea>
              </div>
            </div>
          </div>
          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الخطوة 02</span>
              <div class="field">
                <label class="label" for="home_step2_title">عنوان الخطوة الثانية</label>
                <input class="input" id="home_step2_title" name="home_step2_title" value="<%= s.home_step2_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="home_step2_desc">شرح الخطوة الثانية</label>
                <textarea class="textarea" id="home_step2_desc" name="home_step2_desc" rows="3" maxlength="300"><%= s.home_step2_desc %></textarea>
              </div>
            </div>
          </div>
          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الخطوة 03</span>
              <div class="field">
                <label class="label" for="home_step3_title">عنوان الخطوة الثالثة</label>
                <input class="input" id="home_step3_title" name="home_step3_title" value="<%= s.home_step3_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="home_step3_desc">شرح الخطوة الثالثة</label>
                <textarea class="textarea" id="home_step3_desc" name="home_step3_desc" rows="3" maxlength="300"><%= s.home_step3_desc %></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 2. متجر الاشتراكات (MTS Store)                            -->
    <!-- ========================================================= -->
    <section class="card">
      <div class="card-head flex flex-wrap gap-12 between">
        <h2><i class="fa-solid fa-store"></i> نصوص متجر الاشتراكات (MTS Store)</h2>
        <span class="badge badge-brand">صفحة المتجر</span>
      </div>
      <div class="card-body stack" style="gap:20px">
        <div class="form-grid cols-2">
          <div class="field span-2">
            <label class="label" for="announcement">شريط الإعلان أعلى المتجر</label>
            <input class="input" id="announcement" name="announcement" value="<%= s.announcement %>" maxlength="250">
            <span class="help">شريط الإعلان العلوي الذي يظهر في أعلى الموقع. اتركه فارغاً لإخفائه.</span>
          </div>
          <div class="field span-2">
            <label class="label" for="hero_title">عنوان بانر المتجر الرئيسي</label>
            <input class="input" id="hero_title" name="hero_title" value="<%= s.hero_title %>" maxlength="150" required>
            <span class="help">يمكنك استخدام الرمز «…» لتقسيم العنوان لسطرين مع تلوين السطر الثاني بشكل مميز.</span>
          </div>
          <div class="field span-2">
            <label class="label" for="hero_subtitle">وصف بانر المتجر</label>
            <textarea class="textarea" id="hero_subtitle" name="hero_subtitle" rows="2" maxlength="400"><%= s.hero_subtitle %></textarea>
          </div>
          <div class="field span-2">
            <label class="label" for="checkout_note">ملاحظة صفحة الدفع</label>
            <textarea class="textarea" id="checkout_note" name="checkout_note" rows="2" maxlength="500"><%= s.checkout_note %></textarea>
            <span class="help">تظهر للعميل في أسفل شاشة الدفع قبل تأكيد وإرفاق إيصال التحويل.</span>
          </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:8px 0">
        <h3 class="t-sub" style="font-size:15px;font-weight:700;color:var(--text-strong);margin:0">بطاقات الثقة والضمان الأربعة (Trust Bar)</h3>
        <div class="form-grid cols-2">
          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الضمان 01</span>
              <div class="field">
                <label class="label" for="store_trust_1_title">العنوان</label>
                <input class="input" id="store_trust_1_title" name="store_trust_1_title" value="<%= s.store_trust_1_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="store_trust_1_desc">الوصف</label>
                <input class="input" id="store_trust_1_desc" name="store_trust_1_desc" value="<%= s.store_trust_1_desc %>" maxlength="200">
              </div>
            </div>
          </div>

          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الضمان 02</span>
              <div class="field">
                <label class="label" for="store_trust_2_title">العنوان</label>
                <input class="input" id="store_trust_2_title" name="store_trust_2_title" value="<%= s.store_trust_2_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="store_trust_2_desc">الوصف</label>
                <input class="input" id="store_trust_2_desc" name="store_trust_2_desc" value="<%= s.store_trust_2_desc %>" maxlength="200">
              </div>
            </div>
          </div>

          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الضمان 03</span>
              <div class="field">
                <label class="label" for="store_trust_3_title">العنوان</label>
                <input class="input" id="store_trust_3_title" name="store_trust_3_title" value="<%= s.store_trust_3_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="store_trust_3_desc">الوصف</label>
                <input class="input" id="store_trust_3_desc" name="store_trust_3_desc" value="<%= s.store_trust_3_desc %>" maxlength="200">
              </div>
            </div>
          </div>

          <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
            <div class="card-body stack" style="gap:10px">
              <span class="badge badge-brand">الضمان 04</span>
              <div class="field">
                <label class="label" for="store_trust_4_title">العنوان</label>
                <input class="input" id="store_trust_4_title" name="store_trust_4_title" value="<%= s.store_trust_4_title %>" maxlength="100">
              </div>
              <div class="field">
                <label class="label" for="store_trust_4_desc">الوصف</label>
                <input class="input" id="store_trust_4_desc" name="store_trust_4_desc" value="<%= s.store_trust_4_desc %>" maxlength="200">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 3. الأسئلة الشائعة (FAQ)                                   -->
    <!-- ========================================================= -->
    <section class="card">
      <div class="card-head flex flex-wrap gap-12 between">
        <h2><i class="fa-solid fa-circle-question"></i> الأسئلة الشائعة (FAQ)</h2>
        <span class="badge badge-brand">الدعم والمساعدة</span>
      </div>
      <div class="card-body stack" style="gap:20px">
        <!-- FAQ 1 -->
        <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
          <div class="card-body stack" style="gap:10px">
            <div class="field">
              <label class="label" for="faq_how_to_buy_q">السؤال 1 (طريقة الشراء)</label>
              <input class="input" id="faq_how_to_buy_q" name="faq_how_to_buy_q" value="<%= s.faq_how_to_buy_q %>" maxlength="200">
            </div>
            <div class="field">
              <label class="label" for="faq_how_to_buy_a">الإجابة</label>
              <textarea class="textarea" id="faq_how_to_buy_a" name="faq_how_to_buy_a" rows="3" maxlength="800"><%= s.faq_how_to_buy_a %></textarea>
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
          <div class="card-body stack" style="gap:10px">
            <div class="field">
              <label class="label" for="faq_pay_q">السؤال 2 (طرق الدفع)</label>
              <input class="input" id="faq_pay_q" name="faq_pay_q" value="<%= s.faq_pay_q %>" maxlength="200">
            </div>
            <div class="field">
              <label class="label" for="faq_pay_a">الإجابة</label>
              <textarea class="textarea" id="faq_pay_a" name="faq_pay_a" rows="3" maxlength="800"><%= s.faq_pay_a %></textarea>
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
          <div class="card-body stack" style="gap:10px">
            <div class="field">
              <label class="label" for="faq_delivery_q">السؤال 3 (وقت التسليم)</label>
              <input class="input" id="faq_delivery_q" name="faq_delivery_q" value="<%= s.faq_delivery_q %>" maxlength="200">
            </div>
            <div class="field">
              <label class="label" for="faq_delivery_a">الإجابة</label>
              <textarea class="textarea" id="faq_delivery_a" name="faq_delivery_a" rows="3" maxlength="800"><%= s.faq_delivery_a %></textarea>
            </div>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="card" style="background:var(--bg-subtle);border-color:var(--border)">
          <div class="card-body stack" style="gap:10px">
            <div class="field">
              <label class="label" for="faq_currency_q">السؤال 4 (العملات المتاحة)</label>
              <input class="input" id="faq_currency_q" name="faq_currency_q" value="<%= s.faq_currency_q %>" maxlength="200">
            </div>
            <div class="field">
              <label class="label" for="faq_currency_a">الإجابة</label>
              <textarea class="textarea" id="faq_currency_a" name="faq_currency_a" rows="3" maxlength="800"><%= s.faq_currency_a %></textarea>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- 4. الفوتر وبيانات الهوية والتواصل                         -->
    <!-- ========================================================= -->
    <section class="card">
      <div class="card-head flex flex-wrap gap-12 between">
        <h2><i class="fa-solid fa-id-card"></i> الفوتر وبيانات الهوية والتواصل</h2>
        <span class="badge badge-brand">تذييل الموقع</span>
      </div>
      <div class="card-body form-grid cols-2">
        <div class="field">
          <label class="label" for="store_name">اسم المتجر / الوكالة</label>
          <input class="input" id="store_name" name="store_name" value="<%= s.store_name %>" maxlength="60">
        </div>
        <div class="field">
          <label class="label" for="store_tagline">الشعار النصي (Tagline)</label>
          <input class="input" id="store_tagline" name="store_tagline" value="<%= s.store_tagline %>" maxlength="100">
        </div>
        <div class="field">
          <label class="label" for="whatsapp_number"><i class="fa-brands fa-whatsapp" style="color:var(--whatsapp)"></i> رقم واتساب الرسمي</label>
          <input class="input" id="whatsapp_number" name="whatsapp_number" value="<%= s.whatsapp_number %>" dir="ltr" placeholder="+201093525956">
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label class="label" for="support_email">بريد الدعم والمراسلات</label>
          <input class="input" id="support_email" name="support_email" value="<%= s.support_email %>" dir="ltr" placeholder="support@mts-agency.com">
          <span class="field-error"></span>
        </div>
        <div class="field span-2">
          <label class="label" for="store_address">عنوان المقر الرئيسي</label>
          <input class="input" id="store_address" name="store_address" value="<%= s.store_address %>" maxlength="150" placeholder="جسر السويس، القاهرة، مصر">
        </div>
        <div class="field span-2">
          <label class="label" for="footer_about">نبذة من نحن في الفوتر (About Us)</label>
          <textarea class="textarea" id="footer_about" name="footer_about" rows="3" maxlength="600"><%= s.footer_about %></textarea>
        </div>
        <div class="field span-2">
          <label class="label" for="footer_copyright">نص حقوق الملكية (Copyright)</label>
          <input class="input" id="footer_copyright" name="footer_copyright" value="<%= s.footer_copyright %>" maxlength="150">
        </div>
      </div>
    </section>

    <!-- Save button bar -->
    <div class="card" style="position:sticky;bottom:16px;z-index:20;background:var(--bg);box-shadow:var(--shadow-lg);border-color:var(--brand)">
      <div class="card-body flex flex-wrap gap-12 between" style="align-items:center;padding:14px 20px">
        <div>
          <b>جاهز لحفظ التعديلات؟</b>
          <p class="help mb-0">يتم تطبيق التعديلات فوراً على كافة صفحات وزوار الموقع.</p>
        </div>
        <button class="btn btn-primary btn-lg" type="submit">
          <i class="fa-solid fa-floppy-disk"></i> حفظ كافة نصوص الموقع
        </button>
      </div>
    </div>

  </div>
</form>

<%- include('../partials/bottom') %>
