<%- include('../partials/top') %>
<%
  const p = product || {};
  const features = product ? (JSON.parse(product.features || '[]') || []).join('\n') : '';
  const steps = product ? (JSON.parse(product.activation_steps || '[]') || []).join('\n') : '';
  const major = (minor) => (minor === null || minor === undefined ? '' : (minor / 100).toFixed(2).replace(/\.00$/, ''));
  const rows = plans.length ? plans : [{ id: '', name: 'شهر', duration_days: 30, price: null, old_price: null, stock: null, is_active: 1 }];
  const groups = {};
  platforms.forEach((pl) => { const k = pl.category_name || 'أخرى'; (groups[k] = groups[k] || []).push(pl); });
%>

<nav class="crumbs" aria-label="مسار التنقل">
  <a href="/seller">لوحة البائع</a><i class="fa-solid fa-chevron-left"></i><a href="/seller/products">المنتجات</a><i class="fa-solid fa-chevron-left"></i><span><%= product ? 'تعديل' : 'منتج جديد' %></span>
</nav>

<div class="page-head">
  <div><h1><%= product ? product.title : 'إضافة منتج جديد' %></h1><p>الأسعار بالعملة الأساسية للمتجر (<%= baseCurrency.name %> <%= baseCurrency.symbol %>) وتُحوَّل تلقائياً لعملات الدفع.</p></div>
  <% if (product) { %><div class="actions"><a class="btn btn-ghost" href="/store/product/<%= product.slug %>" target="_blank"><i class="fa-solid fa-up-right-from-square"></i> عرض في المتجر</a></div><% } %>
</div>

<form method="post" action="<%= product ? '/seller/products/' + product.id : '/seller/products' %>" enctype="multipart/form-data" data-ajax novalidate>
  <div class="dash-grid" style="margin-top:0">
    <div class="stack">
      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-circle-info"></i> المعلومات الأساسية</h2></div>
        <div class="card-body form-grid cols-2">
          <div class="field span-2">
            <label class="label" for="title">اسم المنتج <span class="req">*</span></label>
            <input class="input" id="title" name="title" value="<%= p.title || '' %>" maxlength="120" required placeholder="مثال: ChatGPT Plus — ترقية على حسابك">
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label class="label" for="platform_id">المنصة</label>
            <select class="select" id="platform_id" name="platform_id" data-platform-select>
              <option value="">— بدون منصة —</option>
              <% Object.entries(groups).forEach(([cat, list]) => { %>
              <optgroup label="<%= cat %>">
                <% list.forEach((pl) => { %><option value="<%= pl.id %>" data-category="<%= pl.category_id || '' %>"<%= p.platform_id === pl.id ? ' selected' : '' %>><%= pl.name %></option><% }) %>
              </optgroup>
              <% }) %>
            </select>
            <span class="help">تحدد شعار وألوان صورة المنتج. <% if (isAdmin) { %><a class="link" href="/seller/platforms/new">منصة جديدة</a><% } %></span>
          </div>
          <div class="field">
            <label class="label" for="category_id">القسم <span class="req">*</span></label>
            <select class="select" id="category_id" name="category_id" required data-category-select>
              <option value="">اختر القسم</option>
              <% categories.forEach((c) => { %><option value="<%= c.id %>"<%= p.category_id === c.id ? ' selected' : '' %>><%= c.name %></option><% }) %>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="field span-2">
            <label class="label" for="short_description">وصف مختصر</label>
            <input class="input" id="short_description" name="short_description" value="<%= p.short_description || '' %>" maxlength="300" placeholder="جملة أو جملتان تظهران أعلى صفحة المنتج">
          </div>
          <div class="field span-2">
            <label class="label" for="description">الوصف التفصيلي</label>
            <textarea class="textarea" id="description" name="description" rows="6" maxlength="6000"><%= p.description || '' %></textarea>
          </div>
          <div class="field">
            <label class="label" for="features">المزايا <span class="opt">(ميزة في كل سطر)</span></label>
            <textarea class="textarea" id="features" name="features" rows="6" placeholder="وصول لأحدث النماذج&#10;بدون إعلانات"><%= features %></textarea>
          </div>
          <div class="field">
            <label class="label" for="activation_steps">خطوات الشراء والتفعيل <span class="opt">(خطوة في كل سطر)</span></label>
            <textarea class="textarea" id="activation_steps" name="activation_steps" rows="6"><%= steps %></textarea>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-layer-group"></i> الباقات والأسعار</h2><span class="badge badge-brand"><%= baseCurrency.code %></span></div>
        <div class="card-body stack">
          <div class="field" data-field="plans"><span class="field-error"></span></div>
          <div class="repeater" data-repeater>
            <div class="repeater" data-rep-list>
              <% rows.forEach((pl, i) => { %>
              <div class="rep-row plan-row" data-rep-row>
                <input type="hidden" name="plans[<%= i %>][id]" value="<%= pl.id || '' %>" data-rep-key="id">
                <div><span class="mini-label">اسم الباقة *</span><input class="input" name="plans[<%= i %>][name]" value="<%= pl.name %>" maxlength="60" placeholder="شهر / 3 أشهر / سنة" data-rep-key="name"></div>
                <div><span class="mini-label">المدة (يوم)</span><input class="input" type="number" lang="en" min="1" max="3650" name="plans[<%= i %>][duration_days]" value="<%= pl.duration_days || '' %>" list="durations" placeholder="دائم" data-rep-key="duration_days"></div>
                <div><span class="mini-label">السعر (<%= baseCurrency.symbol %>) *</span><input class="input" inputmode="decimal" name="plans[<%= i %>][price]" value="<%= major(pl.price) %>" placeholder="12" dir="ltr" data-rep-key="price"></div>
                <div><span class="mini-label">قبل الخصم</span><input class="input" inputmode="decimal" name="plans[<%= i %>][old_price]" value="<%= major(pl.old_price) %>" placeholder="20" dir="ltr" data-rep-key="old_price"></div>
                <div><span class="mini-label">المخزون</span><input class="input" type="number" lang="en" min="0" name="plans[<%= i %>][stock]" value="<%= pl.stock === null || pl.stock === undefined ? '' : pl.stock %>" placeholder="∞" data-rep-key="stock"></div>
                <label class="switch"><input type="checkbox" name="plans[<%= i %>][is_active]" value="1" data-rep-key="is_active"<%= pl.is_active ? ' checked' : '' %>><span class="track"></span> مفعّلة</label>
                <button class="btn btn-ghost btn-icon btn-sm rep-remove" type="button" data-rep-remove aria-label="حذف الباقة"><i class="fa-solid fa-trash-can"></i></button>
              </div>
              <% }) %>
            </div>
            <template data-rep-template>
              <div class="rep-row plan-row" data-rep-row>
                <input type="hidden" name="plans[__i__][id]" value="" data-rep-key="id">
                <div><span class="mini-label">اسم الباقة *</span><input class="input" name="plans[__i__][name]" maxlength="60" placeholder="شهر / 3 أشهر / سنة" data-rep-key="name"></div>
                <div><span class="mini-label">المدة (يوم)</span><input class="input" type="number" lang="en" min="1" max="3650" name="plans[__i__][duration_days]" list="durations" placeholder="دائم" data-rep-key="duration_days"></div>
                <div><span class="mini-label">السعر (<%= baseCurrency.symbol %>) *</span><input class="input" inputmode="decimal" name="plans[__i__][price]" placeholder="12" dir="ltr" data-rep-key="price"></div>
                <div><span class="mini-label">قبل الخصم</span><input class="input" inputmode="decimal" name="plans[__i__][old_price]" placeholder="20" dir="ltr" data-rep-key="old_price"></div>
                <div><span class="mini-label">المخزون</span><input class="input" type="number" lang="en" min="0" name="plans[__i__][stock]" placeholder="∞" data-rep-key="stock"></div>
                <label class="switch"><input type="checkbox" name="plans[__i__][is_active]" value="1" checked data-rep-key="is_active"><span class="track"></span> مفعّلة</label>
                <button class="btn btn-ghost btn-icon btn-sm rep-remove" type="button" data-rep-remove aria-label="حذف الباقة"><i class="fa-solid fa-trash-can"></i></button>
              </div>
            </template>
            <button class="btn btn-soft btn-sm" type="button" data-rep-add style="justify-self:start"><i class="fa-solid fa-plus"></i> إضافة باقة</button>
          </div>
          <datalist id="durations"><option value="30">شهر</option><option value="90">3 أشهر</option><option value="180">6 أشهر</option><option value="365">سنة</option><option value="730">سنتان</option></datalist>
          <p class="help">اترك «قبل الخصم» فارغاً إن لم يكن هناك خصم. اترك المخزون فارغاً لكمية غير محدودة. المدة تُستخدم لحساب تاريخ انتهاء الاشتراك تلقائياً.</p>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-truck-fast"></i> التسليم والتفعيل</h2></div>
        <div class="card-body form-grid cols-2">
          <div class="field">
            <label class="label" for="delivery_method">طريقة التسليم</label>
            <select class="select" id="delivery_method" name="delivery_method">
              <% Object.entries(deliveryMethods).forEach(([k, m]) => { %><option value="<%= k %>"<%= (p.delivery_method || 'account') === k ? ' selected' : '' %>><%= m.label %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label class="label" for="delivery_time">وقت التسليم المتوقع</label>
            <input class="input" id="delivery_time" name="delivery_time" value="<%= p.delivery_time || 'خلال 30 دقيقة' %>" maxlength="40" list="deliveryTimes">
            <datalist id="deliveryTimes"><option value="فوري"><option value="خلال 15 دقيقة"><option value="خلال 30 دقيقة"><option value="خلال ساعة"><option value="خلال ساعتين"><option value="خلال 24 ساعة"></datalist>
          </div>
          <div class="field">
            <label class="label" for="buyer_input_label">بيانات مطلوبة من المشتري <span class="opt">(اختياري)</span></label>
            <input class="input" id="buyer_input_label" name="buyer_input_label" value="<%= p.buyer_input_label || '' %>" maxlength="100" placeholder="مثال: البريد الإلكتروني لحسابك في Canva">
            <span class="help">إذا كتبت هنا سيظهر حقل إلزامي للمشتري في صفحة الدفع.</span>
          </div>
          <div class="field">
            <label class="label" for="buyer_input_placeholder">مثال للحقل</label>
            <input class="input" id="buyer_input_placeholder" name="buyer_input_placeholder" value="<%= p.buyer_input_placeholder || '' %>" maxlength="100" placeholder="example@gmail.com" dir="ltr">
          </div>
          <div class="field">
            <label class="label" for="warranty">الضمان</label>
            <input class="input" id="warranty" name="warranty" value="<%= product ? (p.warranty || '') : 'ضمان طوال مدة الاشتراك' %>" maxlength="80">
          </div>
          <div class="field">
            <label class="label" for="region_note">التوفر</label>
            <input class="input" id="region_note" name="region_note" value="<%= product ? (p.region_note || '') : 'يعمل في جميع الدول' %>" maxlength="80">
          </div>
        </div>
      </section>
    </div>

    <div class="stack">
      <section class="card card-body stack">
        <h3 class="form-section-title"><i class="fa-solid fa-eye"></i> النشر</h3>
        <label class="switch"><input type="checkbox" name="is_active" value="1"<%= !product || p.is_active ? ' checked' : '' %>><span class="track"></span> معروض في المتجر</label>
        <label class="switch"><input type="checkbox" name="is_featured" value="1"<%= p.is_featured ? ' checked' : '' %>><span class="track"></span> منتج مميز (يظهر أولاً)</label>
        <% if (isAdmin && sellers.length > 1) { %>
        <div class="field">
          <label class="label" for="seller_id">البائع</label>
          <select class="select" id="seller_id" name="seller_id">
            <% sellers.forEach((s) => { %><option value="<%= s.id %>"<%= (product ? p.seller_id : user.id) === s.id ? ' selected' : '' %>><%= s.store_name || s.name %><%= s.role === 'admin' ? ' (المدير)' : '' %></option><% }) %>
          </select>
        </div>
        <% } %>
        <button class="btn btn-primary btn-lg btn-block" type="submit"><i class="fa-solid fa-floppy-disk"></i> <%= product ? 'حفظ التعديلات' : 'إضافة المنتج' %></button>
      </section>

      <section class="card card-body stack">
        <h3 class="form-section-title"><i class="fa-solid fa-image"></i> صورة المنتج</h3>
        <div class="img-uploader">
          <span class="thumb" data-img-preview><% if (p.cover_url) { %><img src="<%= p.cover_url %>" alt=""><% } else { %><i class="fa-regular fa-image" style="font-size:26px"></i><% } %></span>
          <div class="stack-sm grow">
            <input class="input" type="file" name="cover" accept="image/jpeg,image/png,image/webp,image/gif" data-img-input style="padding-top:10px">
            <span class="help">اختياري — بدون صورة يتم إنشاء غلاف تلقائي بشعار المنصة وألوانها. (حتى 4MB)</span>
            <% if (p.cover_url) { %><label class="check small"><input type="checkbox" name="remove_cover" value="1"> حذف الصورة الحالية</label><% } %>
          </div>
        </div>
      </section>

      <section class="card card-body stack">
        <h3 class="form-section-title"><i class="fa-solid fa-fire"></i> العروض والتمييز</h3>
        <div class="field">
          <label class="label" for="badge">شارة على المنتج</label>
          <input class="input" id="badge" name="badge" value="<%= p.badge || '' %>" maxlength="30" list="badges" placeholder="مثال: الأكثر مبيعاً">
          <datalist id="badges"><option value="الأكثر مبيعاً"><option value="عرض محدود"><option value="جديد"><option value="رائج"><option value="سعر اقتصادي"><option value="حصري"></datalist>
        </div>
        <div class="field">
          <label class="label" for="offer_ends_at">ينتهي العرض في <span class="opt">(اختياري)</span></label>
          <input class="input" id="offer_ends_at" type="datetime-local" name="offer_ends_at" value="<%= offerLocal %>">
          <span class="help">يظهر عدّاد تنازلي على المنتج، وبعد انتهاء الوقت يعود السعر تلقائياً إلى «قبل الخصم».</span>
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label class="label" for="slug">رابط المنتج (slug)</label>
          <input class="input" id="slug" name="slug" value="<%= p.slug || '' %>" maxlength="80" dir="ltr" placeholder="يُنشأ تلقائياً من الاسم">
        </div>
      </section>
    </div>
  </div>
</form>

<%- include('../partials/bottom', { scripts: ['/static/js/seller.js'] }) %>
