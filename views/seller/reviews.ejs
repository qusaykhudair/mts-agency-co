<%- include('../partials/top') %>

<div class="page-head">
  <div><h1>التقييمات</h1><p>تقييمات المشترين بعد استلام الاشتراك. يمكنك إخفاء أي تقييم غير لائق.</p></div>
</div>

<section class="card">
  <% if (items.length) { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th>التقييم</th><th>المنتج</th><th>الطلب</th><th>الحالة</th><th></th></tr></thead>
      <tbody>
        <% items.forEach((r) => { %>
        <tr>
          <td class="t-first">
            <div><div class="flex gap-8"><b><%= r.author_name %></b><%- include('../partials/stars', { rating: r.rating }) %><small class="muted"><%= timeAgo(r.created_at) %></small></div>
            <% if (r.comment) { %><p class="small text-2" style="max-width:480px"><%= r.comment %></p><% } %></div>
          </td>
          <td data-label="المنتج"><a class="link small" href="/store/product/<%= r.product_slug %>" target="_blank"><%= r.product_title %></a></td>
          <td data-label="الطلب"><% if (r.order_code) { %><a class="code small" href="/seller/orders/<%= r.order_code %>"><%= r.order_code %></a><% } else { %>-<% } %></td>
          <td data-label="الحالة"><span class="badge <%= r.is_visible ? 'badge-success' : 'badge-muted' %>"><%= r.is_visible ? 'ظاهر' : 'مخفي' %></span></td>
          <td>
            <div class="t-actions">
              <form method="post" action="/seller/reviews/<%= r.id %>/toggle" data-ajax><button class="btn btn-soft btn-sm" type="submit"><%= r.is_visible ? 'إخفاء' : 'إظهار' %></button></form>
              <form method="post" action="/seller/reviews/<%= r.id %>/delete" data-ajax data-confirm="حذف هذا التقييم نهائيا؟" data-confirm-danger><button class="btn btn-danger-soft btn-icon btn-sm" type="submit" aria-label="حذف"><i class="fa-solid fa-trash-can"></i></button></form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty"><span class="ic"><i class="fa-regular fa-star"></i></span><h3>لا توجد تقييمات بعد</h3><p>يستطيع المشترون تقييم المنتجات بعد استلام اشتراكاتهم.</p></div>
  <% } %>
</section>
<%- include('../partials/pagination', { pg }) %>

<%- include('../partials/bottom') %>
