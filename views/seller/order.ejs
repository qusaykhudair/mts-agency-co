<%- include('../partials/top') %>
<%
  const st = ORDER_STATUS[order.status];
  const staffBanner = {
    under_review: ['بانتظار مراجعة إيصال الدفع', 'تحقق من وصول المبلغ المطلوب إلى الحساب ومطابقة اسم صاحب الحساب ورقمه، ثم أكد الدفع أو ارفض الإيصال مع ذكر السبب.'],
    payment_rejected: ['تم رفض الإيصال، بانتظار العميل', 'سيقوم العميل بإرسال إيصال جديد من صفحة الطلب، وسيصلك إشعار عند ذلك.'],
    processing: ['تم تأكيد الدفع، جهز الاشتراك', 'أدخل بيانات الاشتراك في نموذج التسليم ليصل للعميل فورا مع إشعار.'],
    delivered: ['تم التسليم، بانتظار تأكيد العميل', 'يكتمل الطلب تلقائيا بعد ' + settings.auto_complete_days + ' أيام إن لم يبلغ العميل عن مشكلة. يمكنك تعديل البيانات عند الحاجة.'],
    completed: ['الطلب مكتمل', 'تم تسليم الاشتراك وتأكيد الاستلام. يمكنك تحديث البيانات عند الاستبدال خلال فترة الضمان.'],
    cancelled: ['الطلب ملغي', 'تم إلغاء هذا الطلب.'],
  }[order.status];
  const canDeliver = ['processing', 'delivered', 'completed'].includes(order.status) || (order.status === 'under_review' && canReview);
  const isLatin = (v) => /^[\x00-\x7F]+$/.test(String(v || ''));
  const methodDetails = method ? (function () { try { return JSON.parse(method.details || '[]'); } catch (e) { return []; } })() : [];
  const presets = {
    'حساب جاهز': [{ label: 'البريد الإلكتروني', value: '' }, { label: 'كلمة المرور', value: '', secret: true }],
    'كود تفعيل': [{ label: 'كود التفعيل', value: '' }, { label: 'رابط الاسترداد', value: '' }],
    'رابط تفعيل': [{ label: 'رابط التفعيل', value: '' }],
    'دعوة بالبريد': [{ label: 'تم إرسال الدعوة إلى', value: order.buyer_input || '' }, { label: 'طريقة القبول', value: 'افتح بريدك الإلكتروني واضغط على زر قبول الدعوة' }],
    'ترقية الحساب': [{ label: 'الحساب المفعل', value: order.buyer_input || '' }, { label: 'حالة التفعيل', value: 'تم تفعيل الاشتراك على حسابك' }],
  };
%>

<nav class="crumbs" aria-label="مسار التنقل">
  <a href="/seller">لوحة البائع</a><i class="fa-solid fa-chevron-left"></i><a href="/seller/orders">الطلبات</a><i class="fa-solid fa-chevron-left"></i><span><%= order.code %></span>
</nav>

<div class="page-head">
  <div class="flex gap-12 flex-wrap">
    <h1>الطلب <span class="text-brand"><%= order.code %></span></h1>
    <%- include('../partials/status-badge', { status: order.status }) %>
  </div>
  <div class="actions">
    <% if (order.buyer_whatsapp) { %>
    <div class="dd" data-dd>
      <button class="btn btn-whatsapp" type="button" data-dd-toggle><i class="fa-brands fa-whatsapp"></i> مراسلة العميل <i class="fa-solid fa-chevron-down" style="font-size:10px"></i></button>
      <div class="dd-menu" style="min-width:250px">
        <% waTemplates.forEach((t) => { %>
        <a class="dd-item" href="<%= waLink(order.buyer_whatsapp, t.text) %>" target="_blank" rel="noopener"><i class="<%= t.icon %>"></i> <%= t.label %></a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<div class="od" data-order-poll="<%= order.code %>" data-status="<%= order.status %>" data-staff>
  <div class="od-main">
    <section class="card card-body stack">
      <div class="od-head">
        <%- include('../partials/mini-cover', { o: order }) %>
        <div class="grow">
          <b><%= order.product_title %> (<%= order.plan_name %>)<%= order.quantity > 1 ? ' × ' + order.quantity : '' %></b>
          <small><%= durationLabel(order.duration_days) %> · <%= fmtDateTime(order.created_at) %> · <%= timeAgo(order.created_at) %></small>
        </div>
        <% if (order.product_slug) { %><a class="btn btn-ghost btn-sm" href="/store/product/<%= order.product_slug %>" target="_blank"><i class="fa-solid fa-up-right-from-square"></i> المنتج</a><% } %>
      </div>
      <div class="status-banner <%= st.tone %>">
        <span class="ic"><i class="<%= st.icon %>"></i></span>
        <div><b><%= staffBanner[0] %></b><p><%= staffBanner[1] %><% if (order.status === 'payment_rejected' && order.reject_reason) { %>. سبب الرفض: <%= order.reject_reason %><% } %></p></div>
      </div>
      <%- include('../partials/order-stepper', { order }) %>
    </section>

    <section class="card">
      <div class="card-head"><h2><i class="fa-solid fa-file-invoice-dollar"></i> إيصال الدفع والتحقق</h2><span class="badge badge-brand"><%= order.payment_method_name %></span></div>
      <div class="card-body">
        <div class="grid-2">
          <div><%- include('../partials/order-receipt', { order }) %></div>
          <div class="stack-sm">
            <div class="pay-amount" style="margin:0">
              <div><span>المبلغ المطلوب</span><small>الإجمالي: <%- moneyIn(order.total, order.base_currency) %></small></div>
              <b><%- orderPay(order) %></b>
            </div>
            <div class="kv">
              <div class="kv-row"><span>اسم صاحب الحساب</span><span><%= order.sender_name %></span></div>
              <div class="kv-row"><span><%= method ? method.sender_account_label : 'الحساب المحول منه' %></span><span class="flex gap-8"><bdi dir="ltr"><%= order.sender_account %></bdi><button class="copy-btn" type="button" data-copy="<%= order.sender_account %>" aria-label="نسخ"><i class="fa-regular fa-copy"></i></button></span></div>
              <div class="kv-row"><span>سعر الصرف المعتمد</span><span dir="ltr">1 <%= order.base_currency %> = <%= order.pay_rate %> <%= order.pay_currency %></span></div>
              <div class="kv-row"><span>تاريخ الإرسال</span><span><%= fmtDateTime(order.created_at) %></span></div>
              <% if (order.reviewer_name) { %><div class="kv-row"><span>راجعه</span><span><%= order.reviewer_name %></span></div><% } %>
            </div>
          </div>
        </div>

        <% if (methodDetails.length) { %>
        <details class="mt-16" style="border:1px dashed var(--border-strong);border-radius:14px;padding:10px 14px">
          <summary class="bold small" style="cursor:pointer"><i class="fa-solid fa-building-columns text-brand"></i> الحساب المستلم (للمطابقة)</summary>
          <div class="kv mt-8">
            <% methodDetails.forEach((d) => { %><div class="kv-row"><span><%= d.label %></span><span<%= isLatin(d.value) ? ' dir=ltr' : '' %>><%= d.value %></span></div><% }) %>
          </div>
        </details>
        <% } %>

        <% if (order.status === 'under_review' && !canReview) { %>
        <div class="alert alert-warning mt-16"><i class="fa-solid fa-user-shield"></i><div><b>بانتظار تأكيد الدفع من إدارة المتجر</b>المبالغ تحول إلى حسابات المتجر، لذلك تؤكدها الإدارة. ستتمكن من تسليم الاشتراك فور التأكيد وسيصلك إشعار.</div></div>
        <% } %>
        <% if (order.status === 'under_review' && canReview) { %>
        <div class="form-actions mt-16">
          <form method="post" action="/seller/orders/<%= order.code %>/approve" data-ajax data-confirm="هل تأكدت من وصول مبلغ <%= orderPayText(order) %> إلى الحساب؟ سيتم إبلاغ العميل بتأكيد الدفع." data-confirm-title="تأكيد استلام الدفع">
            <button class="btn btn-success btn-lg" type="submit"><i class="fa-solid fa-circle-check"></i> تأكيد استلام الدفع</button>
          </form>
          <button class="btn btn-danger-soft btn-lg" type="button" data-toggle-target="#rejectBox"><i class="fa-solid fa-circle-xmark"></i> رفض الإيصال</button>
        </div>
        <form id="rejectBox" class="stack-sm mt-16" method="post" action="/seller/orders/<%= order.code %>/reject" data-ajax hidden style="padding:14px;border-radius:14px;background:var(--danger-bg)">
          <label class="label" for="reason">سبب الرفض (سيظهر للعميل)</label>
          <div class="flex flex-wrap gap-8">
            <% rejectReasons.forEach((r) => { %><button class="chip" type="button" data-fill="#reason" data-value="<%= r %>" style="height:32px;font-size:12.5px"><%= r %></button><% }) %>
          </div>
          <div class="field">
            <textarea class="textarea" id="reason" name="reason" rows="2" maxlength="400" required placeholder="مثال: المبلغ المحول أقل من المطلوب"></textarea>
            <span class="field-error"></span>
          </div>
          <button class="btn btn-danger" type="submit" style="justify-self:start"><i class="fa-solid fa-paper-plane"></i> تأكيد الرفض وإبلاغ العميل</button>
        </form>
        <% } %>
      </div>
    </section>

    <% if (canDeliver) { %>
    <section class="card<%= ['delivered', 'completed'].includes(order.status) ? ' delivery-card' : '' %>" id="deliver">
      <div class="card-head">
        <h2><i class="fa-solid fa-gift"></i> <%= delivery ? 'بيانات الاشتراك المسلمة' : 'تسليم الاشتراك للعميل' %></h2>
        <% if (delivery) { %><span class="badge badge-success"><i class="fa-solid fa-check"></i> سلم <%= timeAgo(order.delivered_at) %></span><% } %>
      </div>
      <form class="card-body stack" method="post" action="/seller/orders/<%= order.code %>/deliver" data-ajax novalidate
        <% if (order.status === 'under_review') { %>data-confirm="سيتم تأكيد الدفع وتسليم الاشتراك للعميل مباشرة. متابعة؟" data-confirm-title="تأكيد الدفع والتسليم"<% } %>>
        <% if (order.buyer_input) { %>
        <div class="alert alert-brand">
          <i class="fa-solid fa-user-tag"></i>
          <div class="grow"><b><%= order.buyer_input_label || 'بيانات التفعيل من العميل' %></b><bdi dir="ltr"><%= order.buyer_input %></bdi></div>
          <button class="copy-btn" type="button" data-copy="<%= order.buyer_input %>"><i class="fa-regular fa-copy"></i> نسخ</button>
        </div>
        <% } %>
        <% if (order.buyer_note) { %><div class="alert"><i class="fa-solid fa-comment-dots"></i><div><b>ملاحظة العميل</b><span class="pre-line"><%= order.buyer_note %></span></div></div><% } %>
        <% if (order.status === 'under_review') { %>
        <div class="alert alert-warning"><i class="fa-solid fa-circle-info"></i><div>لم يتم تأكيد الدفع بعد. عند التسليم من هنا سيتم تأكيد الدفع تلقائيا.</div></div>
        <% } %>

        <div class="flex flex-wrap gap-8 between">
          <span class="label">قوالب سريعة</span>
          <div class="flex flex-wrap gap-8">
            <% Object.entries(presets).forEach(([name, rows]) => { %>
            <button class="chip" type="button" data-rep-preset="<%= JSON.stringify(rows) %>" style="height:32px;font-size:12.5px"><%= name %></button>
            <% }) %>
          </div>
        </div>

        <div class="repeater" data-repeater>
          <div class="repeater" data-rep-list>
            <% deliveryFields.forEach((f, i) => { %>
            <div class="rep-row pair-row" data-rep-row>
              <div><span class="mini-label">العنوان</span><input class="input" name="fields[<%= i %>][label]" value="<%= f.label %>" maxlength="60" placeholder="مثال: البريد الإلكتروني" data-rep-key="label"></div>
              <div><span class="mini-label">القيمة</span><input class="input" name="fields[<%= i %>][value]" value="<%= f.value %>" maxlength="1000" dir="auto" data-rep-key="value"></div>
              <label class="switch" title="إخفاء القيمة عند العرض للعميل حتى يضغط إظهار"><input type="checkbox" name="fields[<%= i %>][secret]" value="1" data-rep-key="secret"<%= f.secret ? ' checked' : '' %>><span class="track"></span> مخفية</label>
              <button class="btn btn-ghost btn-icon btn-sm rep-remove" type="button" data-rep-remove aria-label="حذف الحقل"><i class="fa-solid fa-trash-can"></i></button>
            </div>
            <% }) %>
          </div>
          <template data-rep-template>
            <div class="rep-row pair-row" data-rep-row>
              <div><span class="mini-label">العنوان</span><input class="input" name="fields[__i__][label]" maxlength="60" placeholder="مثال: البريد الإلكتروني" data-rep-key="label"></div>
              <div><span class="mini-label">القيمة</span><input class="input" name="fields[__i__][value]" maxlength="1000" dir="auto" data-rep-key="value"></div>
              <label class="switch"><input type="checkbox" name="fields[__i__][secret]" value="1" data-rep-key="secret"><span class="track"></span> مخفية</label>
              <button class="btn btn-ghost btn-icon btn-sm rep-remove" type="button" data-rep-remove aria-label="حذف الحقل"><i class="fa-solid fa-trash-can"></i></button>
            </div>
          </template>
          <button class="btn btn-soft btn-sm" type="button" data-rep-add style="justify-self:start"><i class="fa-solid fa-plus"></i> إضافة حقل</button>
        </div>

        <div class="form-grid cols-2">
          <div class="field span-2">
            <label class="label" for="dnote">تعليمات للعميل <span class="opt">(اختياري)</span></label>
            <textarea class="textarea" id="dnote" name="note" rows="3" maxlength="2000" placeholder="مثال: لا تقم بتغيير كلمة المرور أو إضافة رقم هاتف للحساب."><%= delivery ? delivery.note : '' %></textarea>
          </div>
          <div class="field">
            <label class="label" for="expires_at">تاريخ انتهاء الاشتراك</label>
            <input class="input" id="expires_at" type="date" name="expires_at" value="<%= defaultExpiry %>">
            <span class="help">محسوب تلقائيا حسب مدة الباقة (<%= durationLabel(order.duration_days) %>). اتركه فارغا للاشتراك الدائم.</span>
            <span class="field-error"></span>
          </div>
        </div>
        <button class="btn btn-success btn-lg" type="submit" style="justify-self:start">
          <i class="fa-solid fa-paper-plane"></i>
          <%= order.status === 'under_review' ? 'تأكيد الدفع وتسليم الاشتراك' : delivery ? 'حفظ وتحديث بيانات الاشتراك' : 'تسليم الاشتراك للعميل' %>
        </button>
      </form>
    </section>
    <% } %>

    <section class="card">
      <div class="card-head"><h2><i class="fa-solid fa-note-sticky"></i> ملاحظة داخلية</h2><span class="badge badge-warning">لا تظهر للعميل</span></div>
      <form class="card-body stack-sm" method="post" action="/seller/orders/<%= order.code %>/note" data-ajax novalidate>
        <div class="field"><textarea class="textarea" name="note" rows="2" maxlength="1000" placeholder="اكتب ملاحظة للفريق حول هذا الطلب…"></textarea><span class="field-error"></span></div>
        <button class="btn btn-soft btn-sm" type="submit" style="justify-self:start"><i class="fa-solid fa-plus"></i> إضافة ملاحظة</button>
      </form>
    </section>
  </div>

  <aside class="od-side">
    <section class="card card-body">
      <h3 class="form-section-title" style="margin-bottom:12px"><i class="fa-solid fa-user"></i> العميل</h3>
      <div class="flex gap-12 mb-16">
        <% if (order.buyer_avatar) { %><img class="avatar avatar-lg" src="<%= order.buyer_avatar %>" alt="" referrerpolicy="no-referrer"><% } else { %><span class="avatar avatar-lg"><%= initials(order.buyer_name) %></span><% } %>
        <div class="grow" style="min-width:0"><b style="display:block"><%= order.buyer_name %></b><small class="muted ellipsis" style="display:block" dir="ltr"><%= order.buyer_email %></small></div>
      </div>
      <div class="kv">
        <div class="kv-row"><span>واتساب</span><span dir="ltr"><%= order.buyer_whatsapp ? displayWhatsapp(order.buyer_whatsapp) : '-' %></span></div>
        <div class="kv-row"><span>عدد طلباته<%= customerScoped ? ' من منتجاتك' : '' %></span><span><%= customer.orders_count %></span></div>
        <div class="kv-row"><span>إجمالي مشترياته<%= customerScoped ? ' منك' : '' %></span><span><%- moneyBase(customer.spent) %></span></div>
      </div>
      <div class="stack-sm mt-16">
        <% if (order.buyer_whatsapp) { %><a class="btn btn-whatsapp btn-block" href="<%= waLink(order.buyer_whatsapp, waTemplates[3].text) %>" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> فتح محادثة واتساب</a><% } %>
        <% if (isAdmin) { %><a class="btn btn-ghost btn-block" href="/seller/users/<%= order.user_id %>"><i class="fa-solid fa-id-badge"></i> ملف العميل</a><% } %>
      </div>
    </section>

    <% if (order.status === 'delivered' || ['under_review', 'payment_rejected', 'processing'].includes(order.status)) { %>
    <section class="card card-body stack-sm">
      <h3 class="form-section-title"><i class="fa-solid fa-sliders"></i> إجراءات</h3>
      <% if (order.status === 'delivered') { %>
      <form method="post" action="/seller/orders/<%= order.code %>/complete" data-ajax data-confirm="تعليم الطلب كمكتمل؟">
        <button class="btn btn-soft btn-block" type="submit"><i class="fa-solid fa-flag-checkered"></i> تعليم كمكتمل</button>
      </form>
      <% } %>
      <% if (['under_review', 'payment_rejected', 'processing'].includes(order.status)) { %>
      <form method="post" action="/seller/orders/<%= order.code %>/cancel" data-ajax data-confirm="سيتم إلغاء الطلب وإبلاغ العميل." data-confirm-title="إلغاء الطلب" data-confirm-danger data-prompt="سبب الإلغاء (سيظهر للعميل)" data-prompt-name="reason">
        <button class="btn btn-danger-soft btn-block" type="submit"><i class="fa-solid fa-ban"></i> إلغاء الطلب</button>
      </form>
      <% } %>
    </section>
    <% } %>

    <section class="card">
      <div class="card-head"><h2><i class="fa-solid fa-timeline"></i> سجل الطلب</h2></div>
      <div class="card-body"><%- include('../partials/order-timeline', { events, showActor: true }) %></div>
    </section>
  </aside>
</div>

<%- include('../partials/bottom', { scripts: ['/static/js/seller.js', '/static/js/order.js'] }) %>
