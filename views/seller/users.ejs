<%- include('../partials/top') %>

<div class="page-head">
  <div><h1>العملاء والمستخدمون</h1><p>كل الحسابات المسجلة مع أرقام الواتساب للتواصل المباشر.</p></div>
</div>

<nav class="tabs" aria-label="الصلاحيات">
  <a class="tab<%= !role ? ' is-active' : '' %>" href="<%= withQuery({ role: null }) %>">الكل <span class="n"><%= Object.values(roleCounts).reduce((a, b) => a + b, 0) %></span></a>
  <% Object.entries(ROLES).forEach(([k, r]) => { %>
  <a class="tab<%= role === k ? ' is-active' : '' %>" href="<%= withQuery({ role: k }) %>"><%= r.label %> <span class="n"><%= roleCounts[k] || 0 %></span></a>
  <% }) %>
</nav>

<form class="filters" method="get">
  <% if (role) { %><input type="hidden" name="role" value="<%= role %>"><% } %>
  <div class="input-wrap"><i class="fa-solid fa-magnifying-glass"></i><input class="input" type="search" name="q" value="<%= q %>" placeholder="ابحث بالاسم أو البريد أو رقم الواتساب…"></div>
  <button class="btn btn-soft" type="submit"><i class="fa-solid fa-filter"></i> بحث</button>
</form>

<section class="card">
  <% if (items.length) { %>
  <div class="table-wrap">
    <table class="table responsive">
      <thead><tr><th>المستخدم</th><th>واتساب</th><th>الصلاحية</th><th>الطلبات</th><th>المشتريات</th><th>التسجيل</th><th></th></tr></thead>
      <tbody>
        <% items.forEach((u) => { %>
        <tr>
          <td class="t-first">
            <div class="t-main">
              <% if (u.avatar_url) { %><img class="avatar" src="<%= u.avatar_url %>" alt="" referrerpolicy="no-referrer"><% } else { %><span class="avatar"><%= initials(u.name) %></span><% } %>
              <div><b><%= u.name %> <% if (u.google_sub) { %><i class="fa-brands fa-google muted" style="font-size:11px" title="Google"></i><% } %><% if (u.is_blocked) { %> <span class="badge badge-danger">موقوف</span><% } %></b><small dir="ltr"><%= u.email %></small></div>
            </div>
          </td>
          <td data-label="واتساب"><% if (u.wa_e164) { %><a class="small bold" style="color:var(--whatsapp)" href="<%= waLink(u.wa_e164) %>" target="_blank" rel="noopener" dir="ltr"><i class="fa-brands fa-whatsapp"></i> <%= displayWhatsapp(u.wa_e164) %></a><% } else { %><span class="badge badge-warning">لم يكمل</span><% } %></td>
          <td data-label="الصلاحية"><span class="badge badge-<%= ROLES[u.role].tone %>"><%= ROLES[u.role].label %></span></td>
          <td data-label="الطلبات"><%= u.orders_count %></td>
          <td data-label="المشتريات" class="nowrap"><%- moneyBase(u.spent) %></td>
          <td data-label="التسجيل" class="nowrap"><small><%= fmtDate(u.created_at) %></small></td>
          <td><div class="t-actions"><a class="btn btn-soft btn-sm" href="/seller/users/<%= u.id %>">إدارة</a></div></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty"><span class="ic"><i class="fa-solid fa-users"></i></span><h3>لا يوجد مستخدمون</h3><p>لا توجد نتائج مطابقة.</p></div>
  <% } %>
</section>
<%- include('../partials/pagination', { pg }) %>

<%- include('../partials/bottom') %>
