<%- include('../partials/top') %>
<% const c = editing || { icon: 'fa-solid fa-layer-group', is_active: 1, sort_order: 0 }; %>

<div class="page-head">
  <div><h1>الأقسام</h1><p>تظهر الأقسام في القائمة الجانبية للمتجر وفي تصفية المنتجات.</p></div>
</div>

<div class="dash-grid" style="margin-top:0">
  <section class="card">
    <div class="table-wrap">
      <table class="table responsive">
        <thead><tr><th>القسم</th><th>المنصات</th><th>المنتجات</th><th>الترتيب</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
          <% items.forEach((it) => { %>
          <tr>
            <td class="t-first"><div class="t-main"><span class="pm-icon" style="--pm:var(--brand);width:40px;height:40px;font-size:16px"><i class="<%= it.icon %>"></i></span><div><b><%= it.name %></b><small dir="ltr">/store/category/<%= it.slug %></small></div></div></td>
            <td data-label="المنصات"><%= it.platform_count %></td>
            <td data-label="المنتجات"><%= it.product_count %></td>
            <td data-label="الترتيب"><%= it.sort_order %></td>
            <td data-label="الحالة"><span class="badge <%= it.is_active ? 'badge-success' : 'badge-muted' %>"><%= it.is_active ? 'ظاهر' : 'مخفي' %></span></td>
            <td>
              <div class="t-actions">
                <a class="btn btn-soft btn-sm" href="/seller/categories?edit=<%= it.id %>#form"><i class="fa-solid fa-pen"></i> تعديل</a>
                <form method="post" action="/seller/categories/<%= it.id %>/delete" data-ajax data-confirm="حذف قسم «<%= it.name %>»؟" data-confirm-danger>
                  <button class="btn btn-danger-soft btn-icon btn-sm" type="submit" aria-label="حذف"><i class="fa-solid fa-trash-can"></i></button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" id="form">
    <div class="card-head"><h2><i class="fa-solid <%= editing ? 'fa-pen' : 'fa-plus' %>"></i> <%= editing ? 'تعديل القسم' : 'إضافة قسم' %></h2><% if (editing) { %><a class="btn btn-ghost btn-sm" href="/seller/categories">إلغاء</a><% } %></div>
    <form class="card-body stack" method="post" action="/seller/categories" data-ajax novalidate>
      <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
      <div class="field">
        <label class="label" for="name">اسم القسم <span class="req">*</span></label>
        <input class="input" id="name" name="name" value="<%= c.name || '' %>" maxlength="60" required>
        <span class="field-error"></span>
      </div>
      <div class="field">
        <label class="label" for="icon">الأيقونة (Font Awesome)</label>
        <div class="flex gap-8"><span class="pm-icon" style="--pm:var(--brand)"><i class="<%= c.icon %>" data-icon-preview></i></span><input class="input grow" id="icon" name="icon" value="<%= c.icon %>" dir="ltr" data-icon-input placeholder="fa-solid fa-robot"></div>
        <span class="help">من مكتبة <a class="link" href="https://fontawesome.com/search?o=r&m=free" target="_blank" rel="noopener">Font Awesome</a> مثل: fa-solid fa-robot</span>
      </div>
      <div class="field">
        <label class="label" for="description">الوصف</label>
        <textarea class="textarea" id="description" name="description" rows="2" maxlength="400"><%= c.description || '' %></textarea>
      </div>
      <div class="form-grid cols-2">
        <div class="field"><label class="label" for="slug">الرابط (slug)</label><input class="input" id="slug" name="slug" value="<%= c.slug || '' %>" dir="ltr"></div>
        <div class="field"><label class="label" for="sort_order">الترتيب</label><input class="input" id="sort_order" type="number" lang="en" name="sort_order" value="<%= c.sort_order %>" min="0"></div>
      </div>
      <label class="switch"><input type="checkbox" name="is_active" value="1"<%= c.is_active ? ' checked' : '' %>><span class="track"></span> ظاهر في المتجر</label>
      <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ</button>
    </form>
  </section>
</div>

<%- include('../partials/bottom', { scripts: ['/static/js/seller.js'] }) %>
