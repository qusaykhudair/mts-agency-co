<%- include('../partials/top') %>

<div class="page-head">
  <div><h1>إعدادات المتجر</h1><p>بيانات التواصل والنصوص الرئيسية وتسجيل الدخول عبر Google وبريد أكواد التأكيد.</p></div>
</div>

<form method="post" action="/seller/settings" data-ajax novalidate>
  <div class="dash-grid" style="margin-top:0">
    <div class="stack">
      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-store"></i> بيانات المتجر</h2></div>
        <div class="card-body form-grid cols-2">
          <div class="field"><label class="label" for="store_name">اسم المتجر</label><input class="input" id="store_name" name="store_name" value="<%= s.store_name %>" maxlength="60"></div>
          <div class="field"><label class="label" for="store_tagline">الشعار النصي</label><input class="input" id="store_tagline" name="store_tagline" value="<%= s.store_tagline %>" maxlength="80"></div>
          <div class="field">
            <label class="label" for="whatsapp_number"><i class="fa-brands fa-whatsapp" style="color:var(--whatsapp)"></i> رقم واتساب المتجر</label>
            <input class="input" id="whatsapp_number" name="whatsapp_number" value="<%= s.whatsapp_number %>" dir="ltr" placeholder="+201093525956">
            <span class="help">يظهر للعملاء في أزرار التواصل ويستقبل رسائل الطلبات.</span>
            <span class="field-error"></span>
          </div>
          <div class="field"><label class="label" for="support_email">بريد الدعم</label><input class="input" id="support_email" name="support_email" value="<%= s.support_email %>" dir="ltr"><span class="field-error"></span></div>
          <div class="field"><label class="label" for="facebook_url">فيسبوك</label><input class="input" id="facebook_url" name="facebook_url" value="<%= s.facebook_url %>" dir="ltr"></div>
          <div class="field"><label class="label" for="instagram_url">انستغرام</label><input class="input" id="instagram_url" name="instagram_url" value="<%= s.instagram_url %>" dir="ltr"></div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-pen-nib"></i> نصوص الواجهة</h2></div>
        <div class="card-body form-grid">
          <div class="field"><label class="label" for="announcement">شريط الإعلان أعلى المتجر</label><input class="input" id="announcement" name="announcement" value="<%= s.announcement %>" maxlength="200"><span class="help">اتركه فارغا لإخفاء الشريط.</span></div>
          <div class="field"><label class="label" for="hero_title">عنوان البانر الرئيسي</label><input class="input" id="hero_title" name="hero_title" value="<%= s.hero_title %>" maxlength="120"><span class="help">استخدم «…» لتقسيم العنوان إلى سطرين بلون مميز.</span></div>
          <div class="field"><label class="label" for="hero_subtitle">وصف البانر</label><textarea class="textarea" id="hero_subtitle" name="hero_subtitle" rows="2" maxlength="300"><%= s.hero_subtitle %></textarea></div>
          <div class="field"><label class="label" for="checkout_note">ملاحظة صفحة الدفع</label><textarea class="textarea" id="checkout_note" name="checkout_note" rows="2" maxlength="400"><%= s.checkout_note %></textarea></div>
        </div>
      </section>
    </div>

    <div class="stack">
      <% const gActive = google.find((c) => c.active); const gRejected = google.filter((c) => c.problem); %>
      <section class="card" id="google">
        <div class="card-head"><h2><i class="fa-brands fa-google"></i> تسجيل الدخول عبر Google</h2><span class="badge <%= gActive ? 'badge-success' : gRejected.length ? 'badge-danger' : 'badge-muted' %>"><%= gActive ? 'مفعل' : gRejected.length ? 'متوقف' : 'غير مفعل' %></span></div>
        <div class="card-body stack">
          <% if (!gActive) { gRejected.forEach((c) => { %>
          <div class="alert alert-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div class="grow"><b>Google يرفض المعرف المنتهي بـ <bdi dir="ltr"><%= c.id.slice(-30) %></bdi><%= c.source === 'server' ? ' (من Railway)' : '' %></b><%= c.problem %></div>
          </div>
          <% }) } %>
          <% if (gRejected.length && !gActive) { %><p class="help">لذلك أخفينا زر Google عن العملاء حتى تصلحه، ويبقى التسجيل بالبريد متاحا.</p><% } %>
          <% if (gActive) gRejected.forEach((c) => { %><p class="help">المعرف القديم المنتهي بـ <bdi dir="ltr" class="mono"><%= c.id.slice(-30) %></bdi><%= c.source === 'server' ? ' في Railway' : '' %> يرفضه Google، فلا نستخدمه. يمكنك تحديثه أو حذفه من هناك.</p><% }) %>
          <div class="field">
            <label class="label" for="google_client_id">Google OAuth Client ID</label>
            <input class="input mono" id="google_client_id" name="google_client_id" value="<%= s.google_client_id %>" dir="ltr" placeholder="1234567890-xxxx.apps.googleusercontent.com">
            <span class="help"><%= envGoogle ? 'المعرف الذي تكتبه هنا يقدم على GOOGLE_CLIENT_ID المحفوظ في Railway، وإن تركته فارغا نستخدم معرف Railway.' : 'نفحص المعرف مع Google عند كل حفظ، وكل 6 ساعات.' %></span>
            <span class="field-error"></span>
          </div>
          <% if (gActive) { %><p class="help">المعرف المستخدم الآن ينتهي بـ <bdi dir="ltr" class="mono"><%= gActive.id.slice(-30) %></bdi><%= gActive.status === 'ready' ? `، وآخر فحص له مع Google: ${timeAgo(gActive.checkedAt)}، ويعمل.` : '.' %></p><% } %>
          <ol class="pm-steps" style="margin-top:0">
            <li>افتح <a class="link" href="https://console.cloud.google.com/auth/clients" target="_blank" rel="noopener">Google Auth Platform ← Clients</a> واضغط <b style="display:inline">Create client</b>.</li>
            <li>اختر نوع <b style="display:inline">Web application</b>، وسمه مثلا «MTS تسجيل الدخول».</li>
            <li>في <b style="display:inline">Authorized JavaScript origins</b> أضف: <code dir="ltr" class="mono"><%= origin %></code></li>
            <li>في <b style="display:inline">Authorized redirect URIs</b> أضف: <code dir="ltr" class="mono"><%= origin %>/auth/google/callback</code></li>
            <li>انسخ الـ Client ID والصقه هنا ثم احفظ، فيفحصه الموقع مع Google فورا.</li>
          </ol>
          <p class="help">لا تحذف هذا العميل من Google Cloud، فحذفه يوقف زر Google. عميل البريد (من نوع Desktop) عميل آخر منفصل عنه.</p>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-magnifying-glass-chart"></i> الظهور في محركات البحث</h2><span class="badge <%= s.google_site_verification ? 'badge-success' : 'badge-muted' %>"><%= s.google_site_verification ? 'مربوط بـ Google' : 'غير مربوط' %></span></div>
        <div class="card-body stack">
          <div class="field">
            <label class="label" for="google_site_verification">رمز التحقق من Google Search Console</label>
            <input class="input mono" id="google_site_verification" name="google_site_verification" value="<%= s.google_site_verification %>" dir="ltr" placeholder="&lt;meta name=&quot;google-site-verification&quot; content=&quot;…&quot;&gt;">
            <span class="field-error"></span>
          </div>
          <div class="field">
            <label class="label" for="bing_site_verification">رمز التحقق من Bing Webmaster Tools (اختياري)</label>
            <input class="input mono" id="bing_site_verification" name="bing_site_verification" value="<%= s.bing_site_verification %>" dir="ltr">
            <span class="field-error"></span>
          </div>
          <ol class="pm-steps" style="margin-top:0">
            <li>افتح <a class="link" href="https://search.google.com/search-console" target="_blank" rel="noopener">Google Search Console</a> وأضف موقعك بخيار <b style="display:inline">URL prefix</b>.</li>
            <li>اختر طريقة <b style="display:inline">HTML tag</b>، وانسخ الوسم كله أو الرمز وحده والصقه هنا ثم احفظ.</li>
            <li>ارجع إلى Search Console واضغط Verify، ثم أرسل خريطة الموقع من قسم Sitemaps: <code dir="ltr" class="mono"><%= siteUrl %>/sitemap.xml</code></li>
          </ol>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2><i class="fa-solid fa-gears"></i> الطلبات</h2></div>
        <div class="card-body form-grid cols-2">
          <div class="field"><label class="label" for="auto_complete_days">إكمال تلقائي بعد (أيام)</label><input class="input" id="auto_complete_days" type="number" lang="en" name="auto_complete_days" value="<%= s.auto_complete_days %>" min="1" max="60"><span class="help">بعد التسليم إن لم يؤكد العميل.</span></div>
          <div class="field"><label class="label" for="service_auto_complete_days">إغلاق طلبات الخدمات بعد (أيام)</label><input class="input" id="service_auto_complete_days" type="number" lang="en" name="service_auto_complete_days" value="<%= s.service_auto_complete_days %>" min="1" max="90"><span class="help">بعد التسليم إن لم يعتمد العميل أو يطلب تعديلات.</span></div>
          <div class="field"><label class="label" for="max_quantity">أقصى كمية للطلب</label><input class="input" id="max_quantity" type="number" lang="en" name="max_quantity" value="<%= s.max_quantity %>" min="1" max="100"></div>
          <div class="field span-2">
            <label class="switch"><input type="checkbox" name="sellers_can_approve" value="1"<%= s.sellers_can_approve !== '0' ? ' checked' : '' %>><span class="track"></span> السماح للبائعين بتأكيد أو رفض الدفع لطلبات منتجاتهم</label>
            <span class="help">أوقفه إذا كنت تريد أن تراجع إيصالات التحويل بنفسك (لأن المبالغ تصل إلى حسابات المتجر)، وسيتمكن البائع من التسليم بعد تأكيدك. لا يستطيع البائع أبدا إدارة طلب اشتراه بنفسه.</span>
          </div>
        </div>
      </section>

      <button class="btn btn-primary btn-lg btn-block" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ الإعدادات</button>
    </div>
  </div>
</form>

<% const m = mailInfo; const live = m.transport === 'gmail' || m.transport === 'smtp'; %>
<section class="card mt-16" id="mail">
  <div class="card-head">
    <h2><i class="fa-solid fa-envelope-circle-check"></i> بريد أكواد التأكيد</h2>
    <span class="badge badge-<%= { ready: 'success', failed: 'danger', checking: 'muted', off: 'muted', local: 'info' }[m.state] %>"><%= { ready: 'يعمل', failed: 'متوقف', checking: 'قيد الفحص', off: 'غير مضبوط', local: 'تجريبي' }[m.state] %></span>
  </div>
  <div class="card-body stack">
    <% if (m.state === 'ready') { %>
    <p>كل حساب جديد بالبريد يؤكد بريده بكود من 6 أرقام. نرسل الأكواد من <bdi dir="ltr"><%= m.from %></bdi> عبر <%= m.transport === 'gmail' ? 'Gmail' : 'SMTP' %>.<% if (m.health.checkedAt) { %> آخر فحص: <%= timeAgo(m.health.checkedAt) %>.<% } %></p>
    <% } else if (m.state === 'failed') { %>
    <div class="alert alert-danger">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div class="grow"><b><%= m.problem.title %></b><%= m.problem.fix %><% if (m.problem.link) { %> <a class="link" href="<%= m.problem.link %>" target="_blank" rel="noopener"><%= m.problem.linkText %></a><% } %></div>
    </div>
    <p class="help">حتى يعود البريد لا نطلب كود التأكيد، فتدخل الحسابات الجديدة المتجر بلا تأكيد. نعيد الفحص وحدنا كل 5 دقائق، ويمكنك الضغط على «افحص الآن» بعد الإصلاح.</p>
    <details class="help"><summary>التفاصيل كما وصلت من خادم البريد</summary><code class="mono" dir="ltr" style="display:block;white-space:pre-wrap;word-break:break-word;margin-top:6px"><%= m.health.error %></code></details>
    <% } else if (m.state === 'checking') { %>
    <p>نفحص الاتصال بخادم البريد الآن. حدث الصفحة بعد لحظات.</p>
    <% } else if (m.state === 'off') { %>
    <p>البريد غير مضبوط، لذلك لا نطلب كود تأكيد عند التسجيل. أضف في Railway القيم GMAIL_CLIENT_ID و GMAIL_CLIENT_SECRET و GMAIL_REFRESH_TOKEN و MAIL_FROM (الخطوات في ملف README).</p>
    <% } else { %>
    <p>وضع التجربة: تحفظ الرسائل في مجلد data/outbox ولا تصل لأحد.</p>
    <% } %>

    <% if (m.transport !== 'off') { %>
    <div class="flex flex-wrap gap-12" style="align-items:flex-end">
      <form class="grow" method="post" action="/seller/mail/test" data-ajax novalidate style="min-width:240px">
        <div class="field">
          <label class="label" for="mail_test_to">أرسل رسالة تجربة إلى</label>
          <div class="flex gap-8">
            <input class="input grow" id="mail_test_to" name="email" type="email" dir="ltr" autocomplete="email" value="<%= user.email %>" required>
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> أرسل</button>
          </div>
          <span class="field-error"></span>
        </div>
      </form>
      <% if (live) { %>
      <form method="post" action="/seller/mail/check" data-ajax>
        <button class="btn btn-soft" type="submit"><i class="fa-solid fa-rotate"></i> افحص الآن</button>
      </form>
      <% } %>
    </div>
    <p class="help">رسالة التجربة بنفس شكل رسالة الكود، والكود فيها لا يفعل شيئا. ابحث عنها في البريد الوارد ثم في Spam.</p>
    <% } %>

    <% if (m.recent.length) { %>
    <div class="table-wrap">
      <table class="table responsive">
        <thead><tr><th>الوقت</th><th>إلى</th><th>الرسالة</th><th>النتيجة</th></tr></thead>
        <tbody>
          <% for (const r of m.recent) { %>
          <tr>
            <td data-label="الوقت"><%= timeAgo(r.created_at) %></td>
            <td data-label="إلى"><bdi dir="ltr"><%= r.to_email %></bdi></td>
            <td data-label="الرسالة"><%= ({ code: 'كود تأكيد', reset: 'كود استعادة', test: 'رسالة تجربة', backup: 'نسخة احتياطية', notice: 'تنبيه أمان' })[r.kind] || 'رسالة' %></td>
            <td data-label="النتيجة"><% if (r.ok) { %><span class="badge badge-success">أرسلت</span><% } else { %><span class="badge badge-danger" title="<%= r.error %>">لم ترسل</span><% } %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <p class="help">لم يرسل المتجر أي رسالة بعد.</p>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom') %>
