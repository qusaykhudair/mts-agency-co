<%- include('../partials/top') %>
<% const s = editing || { icon: 'fa-solid fa-briefcase', is_active: 1, sort_order: 0 }; %>

<div class="page-head">
  <div><h1>الخدمات</h1><p>الخدمات التي يطلبها العملاء من صفحة <a class="link" href="/services" target="_blank">خدماتنا</a> ومن الصفحة الرئيسية.</p></div>
  <div class="actions"><a class="btn btn-soft" href="/seller/service-requests"><i class="fa-solid fa-inbox"></i> طلبات الخدمات</a></div>
</div>

<div class="dash-grid" style="margin-top:0">
  <section class="card">
    <div class="table-wrap">
      <table class="table responsive">
        <thead><tr><th>الخدمة</th><th>الطلبات</th><th>الترتيب</th><th>الحالة</th><th></th></tr></thead>
        <tbody>
          <% items.forEach((it) => { %>
          <tr>
            <td class="t-first"><div class="t-main"><span class="svc-ic"><i class="<%= it.icon %>"></i></span><div><b><%= it.name %></b><small><%= it.summary || '' %></small></div></div></td>
            <td data-label="الطلبات"><%= it.requests_count %></td>
            <td data-label="الترتيب"><%= it.sort_order %></td>
            <td data-label="الحالة"><span class="badge <%= it.is_active ? 'badge-success' : 'badge-muted' %>"><%= it.is_active ? 'ظاهرة' : 'مخفية' %></span></td>
            <td>
              <div class="t-actions">
                <a class="btn btn-soft btn-sm" href="/seller/services?edit=<%= it.id %>#form"><i class="fa-solid fa-pen"></i> تعديل</a>
                <form method="post" action="/seller/services/<%= it.id %>/delete" data-ajax data-confirm="حذف خدمة «<%= it.name %>»؟" data-confirm-danger>
                  <button class="btn btn-danger-soft btn-icon btn-sm" type="submit" aria-label="حذف"><i class="fa-solid fa-trash-can"></i></button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" id="form">
    <div class="card-head"><h2><i class="fa-solid <%= editing ? 'fa-pen' : 'fa-plus' %>"></i> <%= editing ? 'تعديل الخدمة' : 'إضافة خدمة' %></h2><% if (editing) { %><a class="btn btn-ghost btn-sm" href="/seller/services">إلغاء</a><% } %></div>
    <form class="card-body stack" method="post" action="/seller/services" data-ajax novalidate>
      <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
      <div class="field">
        <label class="label" for="name">اسم الخدمة <span class="req">*</span></label>
        <input class="input" id="name" name="name" value="<%= s.name || '' %>" maxlength="80" required>
        <span class="field-error"></span>
      </div>
      <div class="field">
        <label class="label" for="icon">الأيقونة (Font Awesome)</label>
        <div class="flex gap-8"><span class="svc-ic"><i class="<%= s.icon %>" data-icon-preview></i></span><input class="input grow" id="icon" name="icon" value="<%= s.icon %>" dir="ltr" data-icon-input placeholder="fa-solid fa-pen-ruler"></div>
      </div>
      <div class="field">
        <label class="label" for="summary">وصف مختصر</label>
        <textarea class="textarea" id="summary" name="summary" rows="2" maxlength="300"><%= s.summary || '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="brief_hint">ماذا يكتب العميل في طلبه؟</label>
        <textarea class="textarea" id="brief_hint" name="brief_hint" rows="2" maxlength="400" placeholder="مثال: نوع الموقع، عدد الصفحات، أمثلة تعجبك…"><%= s.brief_hint || '' %></textarea>
        <span class="help">يظهر للعميل كإرشاد أعلى خانة تفاصيل الطلب.</span>
      </div>
      <div class="form-grid cols-2">
        <div class="field"><label class="label" for="slug">الرابط (slug)</label><input class="input" id="slug" name="slug" value="<%= s.slug || '' %>" dir="ltr"></div>
        <div class="field"><label class="label" for="sort_order">الترتيب</label><input class="input" id="sort_order" type="number" lang="en" name="sort_order" value="<%= s.sort_order %>" min="0"></div>
      </div>
      <label class="switch"><input type="checkbox" name="is_active" value="1"<%= s.is_active ? ' checked' : '' %>><span class="track"></span> ظاهرة للعملاء</label>
      <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ</button>
    </form>
  </section>
</div>

<%- include('../partials/bottom', { scripts: ['/static/js/seller.js'] }) %>
