<%- include('../partials/top') %>
<% const pl = platform || { color1: '#3e7bff', color2: '#1b3fbf', is_active: 1, sort_order: 0 }; %>

<nav class="crumbs" aria-label="مسار التنقل">
  <a href="/seller">لوحة البائع</a><i class="fa-solid fa-chevron-left"></i><a href="/seller/platforms">المنصات</a><i class="fa-solid fa-chevron-left"></i><span><%= platform ? platform.name : 'منصة جديدة' %></span>
</nav>
<div class="page-head"><div><h1><%= platform ? 'تعديل منصة: ' + platform.name : 'إضافة منصة' %></h1></div></div>

<form method="post" action="<%= platform ? '/seller/platforms/' + platform.id : '/seller/platforms' %>" enctype="multipart/form-data" data-ajax novalidate>
  <div class="dash-grid" style="margin-top:0">
    <section class="card card-body form-grid cols-2">
      <div class="field">
        <label class="label" for="name">اسم المنصة <span class="req">*</span></label>
        <input class="input" id="name" name="name" value="<%= pl.name || '' %>" maxlength="60" required placeholder="مثال: ChatGPT">
        <span class="field-error"></span>
      </div>
      <div class="field">
        <label class="label" for="category_id">القسم</label>
        <select class="select" id="category_id" name="category_id">
          <option value="">بدون قسم</option>
          <% categories.forEach((c) => { %><option value="<%= c.id %>"<%= pl.category_id === c.id ? ' selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="field span-2">
        <label class="label" for="description">وصف المنصة</label>
        <textarea class="textarea" id="description" name="description" rows="3" maxlength="600"><%= pl.description || '' %></textarea>
      </div>
      <div class="field">
        <label class="label">اللون الأول</label>
        <div class="color-input"><input type="color" name="color1" value="<%= pl.color1 %>" data-color="1"><span class="mono small"><%= pl.color1 %></span></div>
      </div>
      <div class="field">
        <label class="label">اللون الثاني</label>
        <div class="color-input"><input type="color" name="color2" value="<%= pl.color2 %>" data-color="2"><span class="mono small"><%= pl.color2 %></span></div>
      </div>
      <div class="field">
        <label class="label" for="slug">الرابط (slug)</label>
        <input class="input" id="slug" name="slug" value="<%= pl.slug || '' %>" maxlength="60" dir="ltr" placeholder="chatgpt">
      </div>
      <div class="field">
        <label class="label" for="sort_order">الترتيب</label>
        <input class="input" id="sort_order" type="number" lang="en" name="sort_order" value="<%= pl.sort_order %>" min="0" max="9999">
      </div>
    </section>

    <div class="stack">
      <section class="card card-body stack">
        <h3 class="form-section-title"><i class="fa-solid fa-image"></i> الشعار</h3>
        <div class="img-uploader">
          <span class="thumb" data-img-preview style="background:linear-gradient(135deg, <%= pl.color1 %>, <%= pl.color2 %>)"><% if (pl.logo_url) { %><img src="<%= pl.logo_url %>" alt=""><% } %></span>
          <div class="stack-sm grow">
            <input class="input" type="file" name="logo" accept="image/jpeg,image/png,image/webp,image/gif" data-img-input style="padding-top:10px">
            <span class="help">صورة مربعة (512×512 مثلا). بدون شعار يظهر تدرج الألوان فقط.</span>
            <% if (pl.logo_url) { %><label class="check small"><input type="checkbox" name="remove_logo" value="1"> حذف الشعار الحالي</label><% } %>
          </div>
        </div>
      </section>
      <section class="card card-body stack">
        <label class="switch"><input type="checkbox" name="is_featured" value="1"<%= pl.is_featured ? ' checked' : '' %>><span class="track"></span> ضمن «المنصات الأكثر طلبا»</label>
        <label class="switch"><input type="checkbox" name="is_active" value="1"<%= pl.is_active ? ' checked' : '' %>><span class="track"></span> ظاهرة في المتجر</label>
        <button class="btn btn-primary btn-lg btn-block" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ</button>
      </section>
    </div>
  </div>
</form>

<%- include('../partials/bottom', { scripts: ['/static/js/seller.js'] }) %>
