<%- include('../partials/top') %>

<section class="h-section svc-hero">
  <div class="h-wrap">
    <div class="h-head h-head-center">
      <div>
        <span class="h-label">خدمات MTS Agency</span>
        <h1 class="svc-title">كل ما يخص مشروعك في صفحة واحدة</h1>
        <p>تكتب ما تحتاجه وترفق ملفاتك، وتراسل من ينفذ العمل من حسابك. وعندما ينتهي تستلم الملفات والروابط في الصفحة نفسها، وتطلب التعديل إن احتجته.</p>
        <div class="svc-hero-actions">
          <a class="btn btn-primary btn-lg" href="/services/request">اطلب خدمة الآن <i class="fa-solid fa-arrow-left"></i></a>
          <a class="btn btn-lg h-btn-outline" href="<%= waLink(storeWa, 'مرحبا MTS Agency، أريد أن أسأل عن خدماتكم') %>" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> استشارة مجانية</a>
        </div>
      </div>
    </div>

    <div class="svc-grid">
      <% services.forEach((s) => { %>
      <a class="svc-tile" href="/services/request?service=<%= s.slug %>">
        <span class="svc-ic lg"><i class="<%= s.icon %>"></i></span>
        <h3><%= s.name %></h3>
        <% if (s.summary) { %><p><%= s.summary %></p><% } %>
        <span class="svc-go">اطلب الخدمة <i class="fa-solid fa-arrow-left"></i></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="h-section h-alt" id="process">
  <div class="h-wrap">
    <div class="h-head h-head-center">
      <div><span class="h-label">كيف نعمل</span><h2>من الطلب إلى التسليم</h2></div>
    </div>
    <ol class="svc-steps">
      <li><b>01</b><h3>أرسل طلبك</h3><p>اختر الخدمة واكتب ما تحتاجه، وأرفق ملفاتك وأمثلة تعجبك.</p></li>
      <li><b>02</b><h3>نتفق على التفاصيل</h3><p>نقرأ طلبك ونتواصل معك لنتفق على التفاصيل والمدة والتكلفة.</p></li>
      <li><b>03</b><h3>ننفذ ونسلم</h3><p>تراسل من يعمل على طلبك مباشرة، وتستلم الملفات والروابط في حسابك.</p></li>
      <li><b>04</b><h3>تراجع وتعتمد</h3><p>إن أعجبك العمل اعتمده، وإن احتاج تعديلا اكتب ملاحظاتك ونعدله.</p></li>
    </ol>
  </div>
</section>

<section class="h-cta">
  <div class="h-wrap h-cta-in">
    <div>
      <h2>عندك فكرة مشروع؟</h2>
      <p>اكتبها لنا كما هي، حتى لو لم تكتمل بعد. نقرؤها ونرد عليك.</p>
    </div>
    <div class="h-cta-actions">
      <a class="btn btn-lg h-btn-light" href="/services/request">اطلب خدمة <i class="fa-solid fa-arrow-left"></i></a>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
