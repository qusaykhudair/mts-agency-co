<%- include('../partials/top') %>

<section class="svc-form-section">
  <div class="h-wrap">
    <nav class="crumbs" aria-label="مسار التنقل"><a href="/services">خدماتنا</a><i class="fa-solid fa-chevron-left"></i><span>طلب خدمة</span></nav>
    <div class="svc-form-head">
      <h1>أخبرنا بما تحتاجه</h1>
      <p>كلما كانت التفاصيل أوضح، كان التنفيذ أدق وأسرع.</p>
    </div>

    <div class="svc-form-grid">
      <form class="card card-body stack svc-form" method="post" action="/services/request" enctype="multipart/form-data" data-ajax novalidate>
        <div class="field">
          <span class="label">الخدمة المطلوبة <span class="req">*</span></span>
          <div class="svc-pick">
            <% services.forEach((s) => { %>
            <label class="svc-opt">
              <input type="radio" name="service_id" value="<%= s.id %>" data-hint="<%= s.brief_hint || '' %>"<%= selected && selected.id === s.id ? ' checked' : '' %> required>
              <span class="svc-ic"><i class="<%= s.icon %>"></i></span>
              <b><%= s.name %></b>
            </label>
            <% }) %>
          </div>
          <span class="field-error"></span>
        </div>

        <div class="field">
          <label class="label" for="title">عنوان الطلب <span class="req">*</span></label>
          <input class="input" id="title" name="title" maxlength="120" required placeholder="مثال: تصميم شعار وهوية بصرية لمخبز">
          <span class="field-error"></span>
        </div>

        <div class="field">
          <label class="label" for="details">تفاصيل الطلب <span class="req">*</span></label>
          <p class="svc-hint" data-hint-box hidden><i class="fa-regular fa-lightbulb"></i> <span data-hint-text></span></p>
          <textarea class="textarea" id="details" name="details" rows="7" maxlength="5000" required placeholder="اشرح فكرتك وما تتوقعه من النتيجة…"></textarea>
          <span class="field-error"></span>
        </div>

        <div class="form-grid cols-2">
          <div class="field">
            <label class="label" for="budget">الميزانية التقريبية</label>
            <select class="select" id="budget" name="budget">
              <option value="">اختر…</option>
              <% Object.entries(budgets).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label class="label" for="deadline">الموعد المطلوب <span class="opt">(اختياري)</span></label>
            <input class="input" id="deadline" type="date" name="deadline" min="<%= today %>" lang="en">
            <span class="field-error"></span>
          </div>
        </div>

        <div class="field">
          <label class="label" for="links">روابط مرجعية <span class="opt">(اختياري)</span></label>
          <textarea class="textarea" id="links" name="links" rows="2" dir="ltr" placeholder="https://…"></textarea>
          <span class="help">رابط في كل سطر: أمثلة تعجبك، حساباتك على التواصل، أو ملفات على Google Drive.</span>
          <span class="field-error"></span>
        </div>

        <%- include('../partials/file-picker', { id: 'briefFiles', max: 6, maxMb, label: 'أرفق ملفات (شعار، صور، محتوى…)' }) %>
        <div class="progress" data-upload-progress hidden><span style="width:0%"></span></div>

        <button class="btn btn-primary btn-lg btn-block" type="submit"><i class="fa-solid fa-paper-plane"></i> إرسال الطلب</button>
        <p class="help center">نتابع معك من صفحة الطلب في حسابك وعبر واتساب <bdi dir="ltr"><%= displayWhatsapp(user.wa_e164) %></bdi></p>
      </form>

      <aside class="svc-aside">
        <section class="card card-body">
          <h3 class="form-section-title" style="margin-bottom:12px"><i class="fa-solid fa-route"></i> ماذا يحدث بعد الإرسال؟</h3>
          <ol class="svc-next">
            <li><b>يراجع فريقنا طلبك</b><span>ويتواصل معك لتأكيد التفاصيل والتكلفة.</span></li>
            <li><b>يبدأ مختص بالتنفيذ</b><span>وتتابع التقدم وتراسله من صفحة الطلب.</span></li>
            <li><b>تستلم العمل في حسابك</b><span>ملفات وروابط تعتمدها أو تطلب عليها تعديلات.</span></li>
          </ol>
        </section>
        <a class="h-support" href="<%= waLink(storeWa, 'مرحباً MTS Agency، لدي سؤال قبل طلب خدمة') %>" target="_blank" rel="noopener">
          <span class="h-support-ic"><i class="fa-brands fa-whatsapp"></i></span>
          <span class="grow"><b>تحتاج مساعدة في كتابة الطلب؟</b><span dir="ltr"><%= displayWhatsapp(storeWa) %></span></span>
        </a>
      </aside>
    </div>
  </div>
</section>

<%- include('../partials/bottom', { scripts: ['/static/js/services.js'] }) %>
