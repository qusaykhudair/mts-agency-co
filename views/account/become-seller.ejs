<%- include('../partials/top') %>

<div class="page-head">
  <div><h1>أصبح بائعاً في <%= settings.store_name %></h1><p>اعرض اشتراكاتك على عملاء المتجر وأدِر طلباتك من لوحة بائع احترافية.</p></div>
</div>

<div class="dash-grid" style="margin-top:0">
  <section class="card">
    <% if (user.role !== 'buyer') { %>
      <div class="empty">
        <span class="ic"><i class="fa-solid fa-store"></i></span>
        <h3>حسابك يملك صلاحيات البائع</h3>
        <p>يمكنك إضافة المنتجات وإدارة الطلبات من لوحة البائع.</p>
        <a class="btn btn-primary" href="/seller"><i class="fa-solid fa-gauge-high"></i> لوحة البائع</a>
      </div>
    <% } else if (application && application.status === 'pending') { %>
      <div class="empty">
        <span class="ic" style="background:var(--warning-bg);color:var(--warning)"><i class="fa-solid fa-hourglass-half"></i></span>
        <h3>طلبك قيد المراجعة</h3>
        <p>أرسلت طلب فتح متجر «<%= application.store_name %>» بتاريخ <%= fmtDate(application.created_at) %>. سنراجعه ونبلغك بالنتيجة عبر الإشعارات وواتساب.</p>
      </div>
    <% } else { %>
      <div class="card-head"><h2><i class="fa-solid fa-file-signature"></i> طلب الانضمام كبائع</h2></div>
      <form class="card-body stack" method="post" action="/account/become-seller" data-ajax novalidate>
        <% if (application && application.status === 'rejected') { %>
          <div class="alert alert-danger"><i class="fa-solid fa-circle-xmark"></i><div><b>لم تتم الموافقة على طلبك السابق</b><%= application.admin_note || 'يمكنك تعديل بياناتك وإعادة التقديم.' %></div></div>
        <% } %>
        <div class="field">
          <label class="label" for="store_name">اسم المتجر <span class="req">*</span></label>
          <input class="input" id="store_name" name="store_name" maxlength="60" required placeholder="مثال: متجر الاشتراكات الذهبية">
          <span class="field-error"></span>
        </div>
        <div class="field">
          <label class="label" for="about">عرّفنا بنشاطك <span class="req">*</span></label>
          <textarea class="textarea" id="about" name="about" rows="5" maxlength="1000" required placeholder="ما الاشتراكات التي تبيعها؟ منذ متى تعمل في هذا المجال؟ وكيف تسلّم الطلبات؟"></textarea>
          <span class="field-error"></span>
        </div>
        <button class="btn btn-primary btn-lg" type="submit" style="justify-self:start"><i class="fa-solid fa-paper-plane"></i> إرسال الطلب</button>
      </form>
    <% } %>
  </section>

  <section class="card card-body">
    <h3 class="form-section-title" style="margin-bottom:12px"><i class="fa-solid fa-gem"></i> مزايا البيع معنا</h3>
    <ul class="feature-list">
      <li><i class="fa-solid fa-check"></i><span>لوحة بائع لإدارة المنتجات والباقات والأسعار.</span></li>
      <li><i class="fa-solid fa-check"></i><span>مراجعة الإيصالات وتأكيد الدفع وتسليم الاشتراكات بنقرات قليلة.</span></li>
      <li><i class="fa-solid fa-check"></i><span>إشعارات فورية بكل طلب جديد، وتواصل مباشر مع العميل عبر واتساب.</span></li>
      <li><i class="fa-solid fa-check"></i><span>تقارير مبيعات وإحصائيات واضحة.</span></li>
    </ul>
  </section>
</div>

<%- include('../partials/bottom') %>
