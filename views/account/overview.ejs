<%- include('../partials/top') %>

<div class="page-head">
  <div><h1>أهلاً، <%= user.name.split(' ')[0] %> 👋</h1><p>طلباتك واشتراكاتك وطلبات الخدمات في مكان واحد.</p></div>
  <div class="actions">
    <a class="btn btn-primary" href="/store"><i class="fa-solid fa-bag-shopping"></i> تسوّق</a>
    <a class="btn btn-soft" href="/services/request"><i class="fa-solid fa-briefcase"></i> اطلب خدمة</a>
  </div>
</div>

<% attention.forEach((a) => { %>
<div class="alert alert-danger mb-16">
  <i class="fa-solid fa-triangle-exclamation"></i>
  <div class="grow"><b>تم رفض إيصال الدفع للطلب <%= a.code %> (<%= a.product_title %>)</b><%= a.reject_reason %> — أرسل إيصالاً صحيحاً لإكمال طلبك.</div>
  <a class="btn btn-danger btn-sm" href="/account/orders/<%= a.code %>">إعادة الإرسال</a>
</div>
<% }) %>

<div class="stats stats-3">
  <div class="stat warning"><span class="ic"><i class="fa-solid fa-hourglass-half"></i></span><div><small>طلبات قيد التنفيذ</small><b><%= stats.open %></b><a class="stretch" href="/account/orders?tab=review" aria-label="الطلبات قيد التنفيذ"></a></div></div>
  <div class="stat success"><span class="ic"><i class="fa-solid fa-id-card"></i></span><div><small>اشتراكات نشطة</small><b><%= activeSubs %></b><a class="stretch" href="/account/subscriptions" aria-label="اشتراكاتي"></a></div></div>
  <div class="stat info"><span class="ic"><i class="fa-solid fa-briefcase"></i></span><div><small>طلبات خدمات مفتوحة</small><b><%= openServices %></b><a class="stretch" href="/account/services?tab=open" aria-label="طلبات الخدمات"></a></div></div>
</div>

<div class="dash-grid">
  <section class="card">
    <div class="card-head"><h2>آخر الطلبات</h2><a class="sec-link" href="/account/orders">عرض الكل <i class="fa-solid fa-arrow-left"></i></a></div>
    <div class="card-body">
      <% if (recent.length) { %>
        <div class="olist"><% recent.forEach((o) => { %><%- include('../partials/order-card', { o }) %><% }) %></div>
      <% } else { %>
        <div class="empty" style="padding:30px 10px">
          <span class="ic"><i class="fa-solid fa-bag-shopping"></i></span>
          <h3>لا توجد طلبات بعد</h3>
          <p>تصفّح الاشتراكات واختر ما يناسبك، وسيظهر طلبك هنا لتتابعه خطوة بخطوة.</p>
          <a class="btn btn-primary" href="/store/products"><i class="fa-solid fa-grip"></i> تصفّح الاشتراكات</a>
        </div>
      <% } %>
    </div>
  </section>

  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>اشتراكاتي النشطة</h2><a class="sec-link" href="/account/subscriptions">الكل <i class="fa-solid fa-arrow-left"></i></a></div>
      <div class="card-body stack-sm">
        <% if (subs.length) { %>
          <% subs.forEach((s) => { %>
          <a class="sub-card" href="/account/orders/<%= s.code %>">
            <div class="top">
              <%- include('../partials/mini-cover', { o: s }) %>
              <div class="grow"><b><%= s.product_title %></b><small><%= s.plan_name %> · <%= s.daysLeft === null ? 'بدون انتهاء' : s.daysLeft > 0 ? 'متبقٍ ' + daysText(s.daysLeft) : 'ينتهي اليوم' %></small></div>
            </div>
            <% if (s.progress !== null) { %><div class="progress <%= s.daysLeft <= 3 ? 'danger' : s.daysLeft <= 7 ? 'warn' : '' %>"><span style="width:<%= s.progress %>%"></span></div><% } %>
          </a>
          <% }) %>
        <% } else { %>
          <p class="muted small center" style="padding:14px 0">لا توجد اشتراكات نشطة حالياً.</p>
        <% } %>
      </div>
    </section>

    <section class="card">
      <div class="card-head"><h2>طلبات الخدمات</h2><a class="sec-link" href="/account/services">الكل <i class="fa-solid fa-arrow-left"></i></a></div>
      <div class="card-body stack-sm">
        <% if (serviceRequests.length) { %>
          <% serviceRequests.forEach((r) => { %><%- include('../partials/service-card', { r, href: '/account/services/' + r.code }) %><% }) %>
        <% } else { %>
          <p class="muted small center" style="padding:10px 0">لا توجد طلبات خدمات. <a class="link" href="/services">تصفّح خدمات MTS</a></p>
        <% } %>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/bottom') %>
