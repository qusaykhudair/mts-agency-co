<%- include('partials/top', { fullTitle: 'MTS Agency | اشتراكات ChatGPT وCanva بالدفع المحلي، وخدمات التصميم والبرمجة والتسويق' }) %>
<%
  const hp = heroProduct;
  const hpPlans = hp ? hp.plans.slice(0, 3) : [];
  const hpPlan = hp ? hp.cheapest : null;
%>

<!-- ============ Hero ============ -->
<section class="h-hero">
  <div class="h-wrap h-hero-grid">
    <div class="h-hero-copy">
      <h1>اشترك في أدواتك الرقمية المفضلة <span class="h-mark">بدون بطاقة دولية</span></h1>
      <p class="h-lead">ChatGPT وClaude وCanva وCapCut وغيرها من <%= stats.platforms %> منصة عالمية. تدفع بتحويل بنكي أو من محفظتك بالشيكل أو الجنيه، وتصلك بيانات الاشتراك في حسابك بعد أن نتأكد من التحويل.</p>

      <form class="h-search" action="/store/products" method="get" role="search" data-search>
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" name="q" placeholder="ابحث، مثلا: ChatGPT Plus" autocomplete="off" aria-label="ابحث عن اشتراك" data-search-input>
        <button class="btn btn-primary" type="submit">ابحث</button>
        <div class="search-pop" data-search-pop hidden></div>
      </form>

      <ul class="h-checks">
        <li><i class="fa-solid fa-check"></i> دفع محلي بالشيكل أو الجنيه</li>
        <li><i class="fa-solid fa-check"></i> إيصالك يراجعه شخص من فريقنا</li>
        <li><i class="fa-solid fa-check"></i> ضمان طوال مدة الاشتراك</li>
      </ul>
    </div>

    <% if (hp && hpPlan) { %>
    <a class="h-showcase" href="/store/product/<%= hp.slug %>" aria-label="<%= hp.title %>">
      <div class="h-sc-bg" aria-hidden="true"></div>
      <div class="h-sc-card h-sc-product">
        <div class="h-sc-head">
          <span class="h-sc-tile" style="--c1:<%= hp.color1 %>;--c2:<%= hp.color2 %>"><img src="<%= hp.platform_logo %>" alt=""></span>
          <div class="grow"><b><%= hp.title.split('—')[0].trim() %></b><small><%= hp.title.split('—').slice(1).join('—').trim() || hp.platform_name %></small></div>
          <% if (hpPlan.discount) { %><span class="badge badge-sale" dir="ltr">-<%= hpPlan.discount %>%</span><% } %>
        </div>
        <div class="h-sc-plans">
          <% hpPlans.forEach((pl) => { %>
          <span class="<%= pl.id === hpPlan.id ? 'is-on' : '' %>"><i></i><%= pl.name %><b><%- money(pl.price) %></b></span>
          <% }) %>
        </div>
        <div class="h-sc-buy">
          <div><small>يبدأ من</small><b><%- money(hpPlan.price) %></b></div>
          <span class="btn btn-primary btn-sm">اشتر الآن</span>
        </div>
      </div>
    </a>
    <% } %>
  </div>
</section>

<!-- ============ Platforms ============ -->
<% if (platforms.length) { %>
<section class="h-logos" aria-label="المنصات المتوفرة">
  <p class="h-logos-title">اشتراكات أصلية من <b><%= stats.platforms %></b> منصة عالمية</p>
  <div class="h-marquee">
    <div class="h-marquee-track">
      <% [0, 1].forEach((copy) => { %>
        <% platforms.forEach((pl) => { %>
        <a class="h-logo" href="/store/platform/<%= pl.slug %>"<%= copy ? ' aria-hidden="true" tabindex="-1"' : '' %>>
          <img src="<%= pl.logo_url %>" alt="" loading="lazy"><span><%= pl.name %></span>
        </a>
        <% }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ Popular subscriptions ============ -->
<% if (popular.length) { %>
<section class="h-section" id="products">
  <div class="h-wrap">
    <div class="h-head">
      <div>
        <span class="h-label">متجر الاشتراكات</span>
        <h2>الأكثر طلبا</h2>
      </div>
      <a class="h-link" href="/store/products">كل الاشتراكات <i class="fa-solid fa-arrow-left"></i></a>
    </div>
    <div class="pgrid"><% popular.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </div>
</section>
<% } %>

<!-- ============ Agency services ============ -->
<% if (services.length) { %>
<section class="h-section h-alt" id="services">
  <div class="h-wrap">
    <div class="h-head">
      <div>
        <span class="h-label">خدمات MTS Agency</span>
        <h2>الفريق الذي بنى هذا المتجر يعمل على مشروعك</h2>
        <p>اكتب ما تحتاجه وأرفق ملفاتك، وتابع العمل مع من ينفذه حتى تستلمه في حسابك.</p>
      </div>
      <a class="btn btn-primary btn-lg" href="/services/request">اطلب خدمة <i class="fa-solid fa-arrow-left"></i></a>
    </div>
    <div class="svc-grid">
      <% services.forEach((s) => { %>
      <a class="svc-tile" href="/services/request?service=<%= s.slug %>">
        <span class="svc-ic lg"><i class="<%= s.icon %>"></i></span>
        <h3><%= s.name %></h3>
        <% if (s.summary) { %><p><%= s.summary %></p><% } %>
        <span class="svc-go">اطلب الخدمة <i class="fa-solid fa-arrow-left"></i></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ How it works ============ -->
<section class="h-section" id="how">
  <div class="h-wrap">
    <div class="h-head h-head-center">
      <div>
        <span class="h-label">طريقة الشراء</span>
        <h2>ثلاث خطوات من الاختيار إلى الاستلام</h2>
      </div>
    </div>
    <ol class="h-steps">
      <li><span class="svc-ic lg"><i class="fa-solid fa-hand-pointer"></i></span><b>01</b><h3>اختر الاشتراك والباقة</h3><p>قارن الباقات وأسعارها بعملتك، ثم اضغط «اشتر الآن».</p></li>
      <li><span class="svc-ic lg"><i class="fa-solid fa-building-columns"></i></span><b>02</b><h3>حول وارفع الإيصال</h3><p>من بنك فلسطين أو جوال باي أو بال باي أو فودافون كاش. رقم الحساب والمبلغ يظهران لك جاهزين للنسخ.</p></li>
      <li><span class="svc-ic lg"><i class="fa-solid fa-gift"></i></span><b>03</b><h3>استلم اشتراكك</h3><p>نتحقق من التحويل، ثم تظهر بيانات اشتراكك في صفحة طلبك ويصلك إشعار.</p></li>
    </ol>
  </div>
</section>

<!-- ============ Clients ============ -->
<section class="h-clients" aria-label="عملاؤنا">
  <div class="h-wrap">
    <p class="h-clients-title">عملنا مع هؤلاء</p>
    <div class="h-clients-row">
      <% clients.forEach((c) => { %>
        <% if (c.url) { %>
        <a class="h-client" href="<%= c.url %>" target="_blank" rel="noopener" title="<%= c.name %>"><img src="/static/img/clients/<%= c.logo %>.webp" alt="<%= c.name %>" loading="lazy"></a>
        <% } else { %>
        <span class="h-client" title="<%= c.name %>"><img src="/static/img/clients/<%= c.logo %>.webp" alt="<%= c.name %>" loading="lazy"></span>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ Reviews (real buyers only) ============ -->
<% if (rating && reviews.length) { %>
<section class="h-section h-alt" id="reviews">
  <div class="h-wrap">
    <div class="h-head">
      <div>
        <span class="h-label">آراء المشترين</span>
        <h2>تقييم <%= rating.avg %> من 5 من <%= rating.n %> مشتر</h2>
      </div>
    </div>
    <div class="grid-3">
      <% reviews.forEach((r) => { %>
      <figure class="h-review">
        <%- include('partials/stars', { rating: r.rating }) %>
        <blockquote><%= r.comment %></blockquote>
        <figcaption><b><%= r.author_name %></b> · <a href="/store/product/<%= r.product_slug %>"><%= r.product_title %></a></figcaption>
      </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ FAQ ============ -->
<section class="h-section" id="faq">
  <div class="h-wrap h-faq">
    <div class="h-head h-head-center">
      <div><span class="h-label">الأسئلة الشائعة</span><h2>عندك سؤال؟</h2></div>
    </div>
    <div class="faq">
      <% faq.forEach((f, i) => { %><details<%= i === 0 ? ' open' : '' %>><summary><%= f.q %></summary><div class="ans"><%= f.a %></div></details><% }) %>
    </div>
    <p class="h-faq-more">لم تجد إجابتك؟ <a class="link" href="<%= waLink(storeWa, 'مرحبا MTS، عندي سؤال') %>" target="_blank" rel="noopener">اسألنا على واتساب</a></p>
  </div>
</section>

<!-- ============ Final call to action ============ -->
<section class="h-cta">
  <div class="h-wrap h-cta-in">
    <div>
      <h2>جاهز تبدأ؟</h2>
      <p>اختر اشتراكك وادفع من محفظتك، أو أرسل لنا فكرة مشروعك ونرد عليك.</p>
    </div>
    <div class="h-cta-actions">
      <a class="btn btn-lg h-btn-light" href="/store">تسوق الاشتراكات <i class="fa-solid fa-arrow-left"></i></a>
      <a class="btn btn-lg h-btn-ghost" href="/services/request"><i class="fa-solid fa-briefcase"></i> اطلب خدمة</a>
    </div>
  </div>
</section>

<%- include('partials/bottom', { scripts: ['/static/js/home.js'] }) %>
