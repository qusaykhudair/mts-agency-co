<%- include('../partials/top', { nav: 'bare', noindex: true }) %>

<div class="err-page">
  <div>
    <div class="code"><%= code %></div>
    <h1><%= code === 404 ? 'الصفحة غير موجودة' : code === 403 ? 'غير مسموح' : code === 429 ? 'محاولات كثيرة' : 'حدث خطأ' %></h1>
    <p><%= message %></p>
    <div class="flex gap-8 flex-wrap" style="justify-content:center">
      <a class="btn btn-primary" href="/store"><i class="fa-solid fa-store"></i> العودة للمتجر</a>
      <a class="btn btn-ghost" href="<%= waLink(storeWa, 'مرحباً، واجهت مشكلة في الموقع') %>" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> تواصل مع الدعم</a>
    </div>
  </div>
</div>

<%- include('../partials/bottom', { nav: 'bare' }) %>
