# ===== MTS Store — configuration =====
# انسخ هذا الملف باسم .env وعدّل القيم. لا ترفع ملف .env إلى GitHub.

PORT=3000
NODE_ENV=production

# حساب المدير — يُنشأ تلقائياً عند أول تشغيل (غيّر كلمة المرور بعد الدخول)
ADMIN_NAME=مدير المتجر
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_WHATSAPP=+201093525956
# لاستعادة كلمة مرور المدير: ضع كلمة جديدة هنا، أعد التشغيل، ثم احذف هذا السطر
# ADMIN_RESET_PASSWORD=

# تسجيل الدخول عبر Google (اختياري) — Client ID من Google Cloud Console
# يمكن أيضاً إدخاله من لوحة المدير ← إعدادات المتجر
GOOGLE_CLIENT_ID=

# الرابط العام للموقع (يُستخدم في روابط واتساب المرسلة للعملاء)
APP_URL=https://your-domain.com

# عدد البروكسيات أمام التطبيق (Nginx / Render / Railway = 1)
TRUST_PROXY=1

# أماكن حفظ قاعدة البيانات والملفات المرفوعة (اجعلها على قرص دائم عند الاستضافة)
DATA_DIR=data
UPLOAD_DIR=uploads

# المنطقة الزمنية لعرض التواريخ
DISPLAY_TIMEZONE=Africa/Cairo

# ضع false لعدم إضافة المنتجات التجريبية عند أول تشغيل
SEED_DEMO=true

# ===== البريد الإلكتروني: كود تأكيد البريد عند التسجيل =====
# يبقى تأكيد البريد متوقفا حتى تملأ إحدى الطريقتين، والتسجيل يعمل كالمعتاد إلى ذلك الحين.
#
# الطريقة الأولى (الموصى بها، وتعمل على كل خطط Railway): Gmail API
#   1) في Google Cloud Console افتح «APIs & Services ← Library» وفعل «Gmail API».
#   2) من «Google Auth Platform ← Clients» أنشئ Client جديدا من نوع «Desktop app».
#   3) انسخ الـ Client ID والـ Client secret إلى السطرين التاليين، واكتب بريد Gmail الذي سترسل منه في MAIL_FROM.
#   4) شغل الأمر: npm run gmail-auth  ثم وافق في المتصفح بالحساب نفسه، فيحفظ GMAIL_REFRESH_TOKEN هنا تلقائيا.
#   5) انسخ هذه القيم الأربع كما هي إلى Variables في Railway.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# بريد Gmail الذي ترسل منه الأكواد (نفس الحساب الذي وافقت به في الخطوة 4)
MAIL_FROM=
MAIL_FROM_NAME=MTS Store
#
# الطريقة الثانية: SMTP بكلمة مرور تطبيق من Gmail (myaccount.google.com/apppasswords).
# تنبيه: Railway يمنع SMTP في خطط Free وTrial وHobby، فهذه الطريقة لا تعمل عليه إلا في خطة Pro.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
